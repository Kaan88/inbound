<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DownloadManager.Desktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI"
    Title="Inbound Download Manager">

    <Grid x:Name="RootGrid" Background="{ThemeResource InboundWindowBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="QueueFileTemplate">
                <Grid ColumnSpacing="12" Padding="0,3" ToolTipService.ToolTip="{Binding FileName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}" Width="16" Height="16" />
                        <FontIcon Glyph="{Binding FileGlyph}" Visibility="{Binding FileGlyphVisibility}" FontSize="15" />
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" />
                    <TextBlock Grid.Column="3" Text="{Binding EtaText}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Background="{ThemeResource InboundChromeBrush}" BorderThickness="0" Padding="4,1">
            <MenuBarItem x:Name="TasksMenu" Title="Tasks" AccessKey="T">
                <MenuFlyoutItem Text="Add New Download…" AccessKey="N" Click="MenuAdd_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Add Links…" AccessKey="L" Click="MenuAddBatch_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Export Download List…" AccessKey="E" Click="MenuExport_Click" />
                <MenuFlyoutItem Text="Import Download List…" AccessKey="I" Click="MenuImport_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" AccessKey="X" Click="MenuExit_Click" />
            </MenuBarItem>

            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem x:Name="FileOpenItem" Text="Open" AccessKey="O" Click="MenuOpen_Click" />
                <MenuFlyoutItem x:Name="FileOpenFolderItem" Text="Open Folder" AccessKey="F" Click="MenuOpenFolder_Click" />
                <MenuFlyoutItem x:Name="FileMoveRenameItem" Text="Move/Rename…" AccessKey="M" AutomationProperties.AcceleratorKey="Ctrl+M" Click="MenuMoveRename_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FileProgressItem" Text="Progress Details…" AccessKey="P" Click="MenuProgressDetails_Click" />
                <MenuFlyoutItem x:Name="FileDownloadNowItem" Text="Download Now" AccessKey="D" Click="MenuResume_Click" />
                <MenuFlyoutItem x:Name="FileStopItem" Text="Stop Download" AccessKey="S" Click="MenuPause_Click" />
                <MenuFlyoutItem x:Name="FileRedownloadItem" Text="Redownload" AccessKey="R" Click="MenuRedownload_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FileDeleteItem" Text="Delete…" AccessKey="E" KeyboardAcceleratorTextOverride="Delete" Click="MenuDelete_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Servers…" AccessKey="V" Click="MenuServers_Click" />
            </MenuBarItem>

            <MenuBarItem x:Name="DownloadsMenu" Title="Downloads" AccessKey="D">
                <MenuFlyoutItem Text="Stop All" AccessKey="S" Click="MenuStopAll_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete All Completed" AccessKey="D" Click="MenuDeleteCompleted_Click" />
                <MenuFlyoutItem Text="Clean Up Leftover Partial Files…" AccessKey="L" Click="MenuCleanOrphans_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find…" AccessKey="F" Click="MenuFind_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Find Next" AccessKey="N" Click="MenuFindNext_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="StartQueueMenu" Text="Start Queue" AccessKey="Q" />
                <MenuFlyoutSubItem x:Name="StopQueueMenu" Text="Stop Queue" AccessKey="U" />
                <MenuFlyoutSeparator />
                <!-- UI.R15, UI.R16: the limits, each a submenu of common values; a choice applies at once. -->
                <MenuFlyoutSubItem x:Name="DownloadsLimitMenu" Text="Simultaneous Downloads" AccessKey="M" />
                <MenuFlyoutSubItem x:Name="ConnectionsLimitMenu" Text="Connections per Download" AccessKey="C" />
                <MenuFlyoutSubItem x:Name="SpeedLimitMenu" Text="Speed Limit" AccessKey="P" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Scheduler…" AccessKey="H" Click="MenuScheduler_Click" />
                <MenuFlyoutItem Text="Options…" AccessKey="T" Click="MenuOptions_Click" />
            </MenuBarItem>

            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Statistics…" AccessKey="S" Click="MenuStatistics_Click" />
                <ToggleMenuFlyoutItem x:Name="ShowSpeedGraphMenuItem" Text="Download Speed Graph" AccessKey="G" IsChecked="True" Click="MenuSpeedGraph_Click" />
                <ToggleMenuFlyoutItem x:Name="HideCategoriesMenuItem" Text="Hide Categories" AccessKey="C" Click="MenuHideCategories_Click" />
                <MenuFlyoutSubItem Text="Arrange Files" AccessKey="A">
                    <MenuFlyoutItem Text="By Order of Addition" AccessKey="A" Tag="added" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By File Name" AccessKey="N" Tag="name" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Size" AccessKey="S" AutomationProperties.AcceleratorKey="Ctrl+Shift+S" Tag="size" Click="MenuSort_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="By Status" AccessKey="T" Tag="status" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Transfer Rate" AccessKey="R" Tag="rate" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Last Try Date" AccessKey="L" Tag="lastTry" Click="MenuSort_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Toolbar" AccessKey="T">
                    <MenuFlyoutItem Text="Large Buttons" AccessKey="L" Click="MenuLargeToolbar_Click" />
                    <MenuFlyoutItem Text="Small Buttons" AccessKey="S" Click="MenuSmallToolbar_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="DarkModeMenuItem" Text="Dark Mode" AccessKey="D" IsChecked="True" Click="MenuDarkMode_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="Check for Updates…" AccessKey="U" Click="MenuUpdate_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Inbound Download Manager" AccessKey="A" Click="MenuAbout_Click" />
                <MenuFlyoutItem Text="Open Diagnostics Folder" AccessKey="D" Click="MenuDiagnostics_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,1">
            <Border.Resources>
                <!-- Toolbar buttons are flat: disabled ones only dim, they do not get a gray box. -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            </Border.Resources>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Padding="8,4" Spacing="0">
                    <Button x:Name="AddButton" AutomationProperties.Name="Add URL" Style="{StaticResource InboundToolButtonStyle}" Click="AddButton_Click"
                            ToolTipService.ToolTip="Add a new download URL">
                        <StackPanel>
                            <FontIcon Glyph="&#xE710;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Text="Add URL" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="ResumeButton" AutomationProperties.Name="Resume" Style="{StaticResource InboundToolButtonStyle}" Click="ResumeButton_Click"
                            ToolTipService.ToolTip="Resume the selected download">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="{ThemeResource InboundIconStartBrush}" />
                            <TextBlock Text="Resume" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" AutomationProperties.Name="Stop" Style="{StaticResource InboundToolButtonStyle}" Click="PauseButton_Click"
                            ToolTipService.ToolTip="Stop the selected download (partial data is kept)">
                        <StackPanel>
                            <FontIcon Glyph="&#xE769;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopAllButton" AutomationProperties.Name="Stop All" Style="{StaticResource InboundToolButtonStyle}" Click="MenuStopAll_Click"
                            ToolTipService.ToolTip="Stop all active downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop All" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelPackageButton" AutomationProperties.Name="Cancel Package" Style="{StaticResource InboundToolButtonStyle}" Click="MenuCancelPackage_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Cancel the unfinished files in the selected package (partial data is kept)">
                        <StackPanel>
                            <FontIcon Glyph="&#xE711;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Cancel Package" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="DeleteButton" AutomationProperties.Name="Delete" Style="{StaticResource InboundToolButtonStyle}" Click="DeleteButton_Click"
                            ToolTipService.ToolTip="Delete the selected download and its partial data">
                        <StackPanel>
                            <FontIcon Glyph="&#xE74D;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Delete" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteCompletedButton" AutomationProperties.Name="Delete Completed" Style="{StaticResource InboundToolButtonStyle}" Click="MenuDeleteCompleted_Click"
                            ToolTipService.ToolTip="Remove completed downloads from the list">
                        <StackPanel>
                            <FontIcon Glyph="&#xE894;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Delete Completed" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="OptionsButton" AutomationProperties.Name="Options"
                            Style="{StaticResource InboundToolButtonStyle}" Click="MenuOptions_Click"
                            ToolTipService.ToolTip="Open Download Manager settings">
                        <StackPanel>
                            <FontIcon Glyph="&#xE713;" FontSize="25" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                            <TextBlock Text="Options" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SchedulerButton" AutomationProperties.Name="Scheduler" Style="{StaticResource InboundToolButtonStyle}"
                            Click="MenuScheduler_Click"
                            ToolTipService.ToolTip="Manage scheduled queue runs">
                        <StackPanel>
                            <FontIcon Glyph="&#xE787;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Text="Scheduler" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="StartQueueButton" AutomationProperties.Name="Start Queue" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StartQueueButton_Click"
                            ToolTipService.ToolTip="Start the selected queue">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="{ThemeResource InboundIconStartBrush}" />
                            <TextBlock Text="Start Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopQueueButton" AutomationProperties.Name="Stop Queue" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StopQueueButton_Click"
                            ToolTipService.ToolTip="Stop the selected queue and pause its downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- What extraction wants the user to know. It sits above the list and waits; nothing opens by itself. -->
        <Border x:Name="ArchiveNoticeBar" Grid.Row="2" Visibility="Collapsed" Padding="10,4"
                Background="{ThemeResource InboundHighlightBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ArchiveNoticeText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Extraction notice" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ArchiveNoticeAction" Grid.Column="1" FontSize="12" Padding="10,2" Click="ArchiveNoticeAction_Click" />
                <Button x:Name="ArchiveNoticeDismiss" Grid.Column="2" Content="Dismiss" FontSize="12" Padding="10,2"
                        AutomationProperties.Name="Dismiss this extraction notice" Click="ArchiveNoticeDismiss_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Categories" FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Margin="22,9,8,3" />
                    <ListBox x:Name="CategoryList" AutomationProperties.Name="Categories" Grid.Row="1" Background="Transparent"
                             BorderThickness="0" SelectionMode="Single"
                             SelectionChanged="CategoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource InboundCategoryItemStyle}">
                        <ListBox.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            </Style>
                        </ListBox.Resources>
                        <ListBoxItem Tag="all" AutomationProperties.Name="All Downloads" Padding="24,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="All Downloads" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="compressed" AutomationProperties.Name="Compressed" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <TextBlock Text="Compressed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="documents" AutomationProperties.Name="Documents" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource InboundIconInfoBrush}" />
                                <TextBlock Text="Documents" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="music" AutomationProperties.Name="Music" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource InboundIconMediaBrush}" />
                                <TextBlock Text="Music" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="programs" AutomationProperties.Name="Programs" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource InboundIconStartBrush}" />
                                <TextBlock Text="Programs" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="video" AutomationProperties.Name="Video" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{ThemeResource InboundIconDangerBrush}" />
                                <TextBlock Text="Video" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="other" AutomationProperties.Name="Other" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Other" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Content=" " IsEnabled="False" MinHeight="8" Padding="0" AutomationProperties.AccessibilityView="Raw" />
                        <ListBoxItem Tag="unfinished" AutomationProperties.Name="Unfinished" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Unfinished" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="active" AutomationProperties.Name="Active" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{ThemeResource InboundIconInfoBrush}" />
                                <TextBlock Text="Active" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="queued" AutomationProperties.Name="Queued" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <TextBlock Text="Queued" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="failed" AutomationProperties.Name="Failed" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource InboundIconDangerBrush}" />
                                <TextBlock Text="Failed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="finished" AutomationProperties.Name="Finished" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource InboundIconStartBrush}" />
                                <TextBlock Text="Finished" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="queues" AutomationProperties.Name="Queues" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Queues" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer x:Name="DownloadListViewport" Grid.Column="1"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="DownloadListGrid" Background="{ThemeResource InboundSurfaceBrush}" RowSpacing="0"
                  MinWidth="1040" Width="{Binding ViewportWidth, ElementName=DownloadListViewport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
                    <!-- Built in ColumnHeaderRow: a button that sorts and a grip that resizes, per column. -->
                    <Grid x:Name="JobsHeader" Padding="4,0" ColumnSpacing="0" />
                </Border>

                <Grid Grid.Row="1">

                    <ListView x:Name="JobsList"
                              AutomationProperties.Name="Downloads"
                              Background="{ThemeResource InboundSurfaceBrush}"
                              BorderThickness="0"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource InboundListRowStyle}"
                              SelectionChanged="JobsList_SelectionChanged"
                              KeyDown="JobsList_KeyDown"
                              PreviewKeyDown="JobsList_PreviewKeyDown"
                              DoubleTapped="JobsList_DoubleTapped"
                              RightTapped="JobsList_RightTapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Loaded="JobsList_Loaded">
                        <!-- No entrance/add animations: the list is rebuilt on expand, collapse and
                             view changes, and the default transition slid every row up from below. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="27" Padding="4,0" ColumnSpacing="0" Background="Transparent"
                                      BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="{Binding RowBorder}"
                                      ToolTipService.ToolTip="{Binding RowToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.ColumnSpan="2" Width="30" HorizontalAlignment="Left" Margin="{Binding IconIndent}" Visibility="{Binding FileIconAreaVisibility}">
                                        <FontIcon Glyph="{Binding FileGlyph}" FontSize="15" Foreground="{ThemeResource InboundIconInfoBrush}"
                                                  Visibility="{Binding FileGlyphVisibility}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}"
                                               Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                    <Border Tag="RowAction" Width="22" Height="22" CornerRadius="4" Background="Transparent"
                                            Visibility="{Binding ChevronVisibility}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Tapped="PackageChevron_Tapped" DoubleTapped="PackageChevron_DoubleTapped"
                                            PointerEntered="PackageChevron_PointerEntered"
                                            PointerExited="PackageChevron_PointerExited"
                                            ToolTipService.ToolTip="Expand or collapse"
                                            AutomationProperties.Name="Expand or collapse package">
                                        <FontIcon Glyph="{Binding ChevronGlyph}" FontSize="11"
                                                  Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="{Binding NameIndent}" Text="{Binding FileName}" FontSize="12" FontWeight="{Binding NameWeight}" FontStyle="{Binding NameStyle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding QueueText}" FontSize="11"
                                                VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                               ToolTipService.ToolTip="{Binding QueueName}" />
                                    <!-- UI.R6: live counters line up on the right in their fixed columns, with tabular figures, so
                                         the units hold still when the digit count changes. The margin matches the header's. -->
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11" AutomationProperties.AutomationId="SizeCell"
                                               HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Style="{StaticResource InboundProgressBarStyle}" Margin="0,1,6,0"
                                                     Visibility="{Binding ProgressVisibility}" />
                                    </StackPanel>
                                    <Grid Grid.Column="5" Visibility="{Binding ExtractionColumnVisibility}" ColumnSpacing="4" Padding="0,0,6,0"
                                          Background="Transparent" ToolTipService.ToolTip="{Binding ArchiveToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ArchiveText}" FontSize="11" Foreground="{Binding ArchiveBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Width="22" Height="20" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0"
                                                Background="Transparent" VerticalAlignment="Center"
                                                Visibility="{Binding ArchivePasswordVisibility}" Click="ArchiveRowPassword_Click"
                                                ToolTipService.ToolTip="Enter the archive's password"
                                                AutomationProperties.Name="Enter the archive's password">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="12" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Grid.Column="6" Text="{Binding EtaText}" FontSize="11" AutomationProperties.AutomationId="EtaCell"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{Binding SpeedText}" FontSize="11" AutomationProperties.AutomationId="RateCell"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="8" Text="{Binding LastTryText}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="9" Text="{Binding Description}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText"
                               Text="No downloads in this view.&#x0a;Use Add URL or the browser extension to start one."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" FontSize="12" />
                    <Canvas x:Name="JobsRegionLayer" IsHitTestVisible="False" />
                </Grid>
            </Grid>
            </ScrollViewer>
            <!-- Always-visible scrollbar, outside the horizontal scroller so it stays at the right edge; kept in sync with the list's own ScrollViewer
                 (WinUI's built-in one collapses to a thin auto-hiding line). -->
            <Grid x:Name="JobsScrollTrack" Grid.Column="1" Width="12" HorizontalAlignment="Right" Margin="0,27,0,0" Visibility="Collapsed"
                  Background="{ThemeResource InboundChromeBrush}"
                  PointerPressed="JobsScrollTrack_PointerPressed"
                  PointerMoved="JobsScrollTrack_PointerMoved"
                  PointerReleased="JobsScrollTrack_PointerReleased"
                  PointerCaptureLost="JobsScrollTrack_PointerReleased"
                  PointerEntered="JobsScrollTrack_PointerEntered"
                  PointerExited="JobsScrollTrack_PointerExited"
                  SizeChanged="JobsScrollTrack_SizeChanged">
                <Border x:Name="JobsScrollThumb" VerticalAlignment="Top" Margin="3,0,3,0"
                        CornerRadius="3" Opacity="0.45"
                        Background="{ThemeResource InboundSecondaryTextBrush}" />
            </Grid>
        </Grid>

        <local:DownloadSpeedGraph x:Name="SpeedGraph" Grid.Row="4" />

        <Border Grid.Row="5" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,0"
                Height="23">
            <Grid Padding="2,0,8,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Which Host the window shows: This PC or a saved server (design D9, section 5). -->
                <DropDownButton x:Name="ServerSwitcher" Content="This PC" FontSize="11" Padding="6,0" MinHeight="0" Height="21"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                AutomationProperties.Name="Show downloads of" ToolTipService.ToolTip="Show the downloads of this PC or of another server">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ServerSwitcherMenu" Placement="TopEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting…" FontSize="11" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- Passing messages are announced here. StatusText changes on its own as counts move, so it isn't a live region. -->
                <TextBlock x:Name="StatusAnnouncer" Grid.Column="1" Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                           AutomationProperties.Name="Status message" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ConnectionText" Grid.Column="2" Text="Connecting…" FontSize="11"
                            Foreground="{ThemeResource InboundSecondaryTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
