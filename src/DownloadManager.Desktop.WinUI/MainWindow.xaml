<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DownloadManager.Desktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Download Manager">

    <Grid x:Name="RootGrid" Background="#1E1E1E" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Background="#1B1B1B" BorderThickness="0" Padding="4,1">
            <MenuBarItem Title="Tasks">
                <MenuFlyoutItem Text="Add new download..." Click="MenuAdd_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Add batch download..." Click="MenuAddBatch_Click" />
                <MenuFlyoutItem Text="Run site grabber..." Click="MenuGrabber_Click" />
                <MenuFlyoutItem Text="Grabber projects..." Click="MenuGrabberProjects_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="MenuExit_Click" />
            </MenuBarItem>

            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Export download list..." Click="MenuExport_Click" />
                <MenuFlyoutItem Text="Import download list..." Click="MenuImport_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Stop Download" Click="MenuPause_Click" />
                <MenuFlyoutItem Text="Remove" Click="MenuRemove_Click" />
                <MenuFlyoutItem Text="Download Now" Click="MenuResume_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Downloads">
                <MenuFlyoutItem Text="Pause All" Click="MenuPauseAll_Click" />
                <MenuFlyoutItem Text="Stop All" Click="MenuStopAll_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete All Completed" Click="MenuDeleteCompleted_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find..." Click="MenuFind_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Scheduler..." Click="MenuScheduler_Click" />
                <MenuFlyoutItem Text="Options..." Click="MenuOptions_Click" />
            </MenuBarItem>

            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="HideCategoriesMenuItem" Text="Hide categories" Click="MenuHideCategories_Click" />
                <MenuFlyoutSubItem Text="Arrange files">
                    <MenuFlyoutItem Text="By Order Of Addition" Tag="added" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By File Name" Tag="name" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Size" Tag="size" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Status" Tag="status" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Transfer Rate" Tag="rate" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Last Try Date" Tag="lastTry" Click="MenuSort_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Toolbar">
                    <MenuFlyoutItem Text="Large Buttons" Click="MenuLargeToolbar_Click" />
                    <MenuFlyoutItem Text="Small Buttons" Click="MenuSmallToolbar_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="DarkModeMenuItem" Text="Dark Mode" IsChecked="True" Click="MenuDarkMode_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Check for updates..." Click="MenuUpdate_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Download Manager" Click="MenuAbout_Click" />
                <MenuFlyoutItem Text="Open diagnostics folder" Click="MenuDiagnostics_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1" Background="#232323" BorderBrush="#333333" BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Padding="8,4" Spacing="0">
                    <Button x:Name="AddButton" Style="{StaticResource InboundToolButtonStyle}" Click="AddButton_Click"
                            ToolTipService.ToolTip="Add a new download URL">
                        <StackPanel>
                            <FontIcon Glyph="&#xE710;" FontSize="25" Foreground="#E6E6E6" />
                            <TextBlock Text="Add URL" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ResumeButton" Style="{StaticResource InboundToolButtonStyle}" Click="ResumeButton_Click"
                            ToolTipService.ToolTip="Resume the selected download">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="#8CCF8C" />
                            <TextBlock Text="Resume" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource InboundToolButtonStyle}" Click="PauseButton_Click"
                            ToolTipService.ToolTip="Stop the selected download (partial data is kept)">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="#E8B36A" />
                            <TextBlock Text="Stop" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopAllButton" Style="{StaticResource InboundToolButtonStyle}" Click="MenuStopAll_Click"
                            ToolTipService.ToolTip="Stop all active downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="#D98C8C" />
                            <TextBlock Text="Stop All" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource InboundToolButtonStyle}" Click="DeleteButton_Click"
                            ToolTipService.ToolTip="Delete the selected download and its partial data">
                        <StackPanel>
                            <FontIcon Glyph="&#xE74D;" FontSize="25" Foreground="#D98C8C" />
                            <TextBlock Text="Delete" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteCompletedButton" Style="{StaticResource InboundToolButtonStyle}" Click="MenuDeleteCompleted_Click"
                            ToolTipService.ToolTip="Remove completed downloads from the list">
                        <StackPanel>
                            <FontIcon Glyph="&#xE73E;" FontSize="25" Foreground="#A0A0A0" />
                            <TextBlock Text="Delete Completed" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource InboundToolButtonStyle}" Click="MenuOptions_Click"
                            ToolTipService.ToolTip="Open Download Manager settings">
                        <StackPanel>
                            <FontIcon Glyph="&#xE713;" FontSize="25" Foreground="#6FA8DC" />
                            <TextBlock Text="Options" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SchedulerButton" Style="{StaticResource InboundToolButtonStyle}"
                            Click="MenuScheduler_Click"
                            ToolTipService.ToolTip="Manage scheduled queue and grabber runs">
                        <StackPanel>
                            <FontIcon Glyph="&#xE787;" FontSize="25" Foreground="#E8B36A" />
                            <TextBlock Text="Scheduler" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartQueueButton" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StartQueueButton_Click"
                            ToolTipService.ToolTip="Start the selected queue">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="#8CCF8C" />
                            <TextBlock Text="Start Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopQueueButton" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StopQueueButton_Click"
                            ToolTipService.ToolTip="Stop the selected queue and pause its downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="#D98C8C" />
                            <TextBlock Text="Stop Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Categories" FontSize="12" FontWeight="SemiBold"
                               Foreground="#D7D7D7" Margin="22,9,8,3" />
                    <ListBox x:Name="CategoryList" Grid.Row="1" Background="Transparent"
                             BorderThickness="0" SelectionMode="Single"
                             SelectionChanged="CategoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource InboundCategoryItemStyle}">
                        <ListBoxItem Tag="all" Padding="24,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#C9C9C9" />
                                <TextBlock Text="All Downloads" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="compressed" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="#C9A46A" />
                                <TextBlock Text="Compressed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="documents" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="#8FB8DE" />
                                <TextBlock Text="Documents" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="music" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="#B49AD6" />
                                <TextBlock Text="Music" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="programs" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="#8CCF8C" />
                                <TextBlock Text="Programs" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="video" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="#D98C8C" />
                                <TextBlock Text="Video" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Content=" " IsEnabled="False" MinHeight="8" Padding="0" />
                        <ListBoxItem Tag="unfinished" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="#C9C9C9" />
                                <TextBlock Text="Unfinished" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="finished" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#8CCF8C" />
                                <TextBlock Text="Finished" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="queues" Padding="14,2,8,2" IsEnabled="False"
                                     ToolTipService.ToolTip="Queue support is not implemented yet">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="#777777" />
                                <TextBlock Text="Queues" Foreground="#777777" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="grabber" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#C9C9C9" />
                                <TextBlock Text="Grabber Projects" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#1E1E1E" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
                    <Grid Padding="4,0" ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="" />
                        <TextBlock Grid.Column="1" Text="File Name" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="Q" Style="{StaticResource InboundHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="Time left" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="6" Text="Transfer rate" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="7" Text="Last Try Date" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="8" Text="Description" Style="{StaticResource InboundHeaderTextStyle}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListView x:Name="JobsList"
                              Background="#1E1E1E"
                              BorderThickness="0"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource InboundListRowStyle}"
                              SelectionChanged="JobsList_SelectionChanged"
                              DoubleTapped="JobsList_DoubleTapped"
                              RightTapped="JobsList_RightTapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="27" Padding="4,0" ColumnSpacing="0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding FileGlyph}" FontSize="15" Foreground="#7FA8CF"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding QueueText}" FontSize="11"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#A0A0A0"
                                               ToolTipService.ToolTip="{Binding QueueName}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="3"
                                                     Visibility="{Binding ProgressVisibility}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding EtaText}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="#B8B8B8" />
                                    <TextBlock Grid.Column="6" Text="{Binding SpeedText}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="#B8B8B8" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{Binding LastTryText}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="#B8B8B8" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="8" Text="{Binding Description}" FontSize="11"
                                               VerticalAlignment="Center" Foreground="#A0A0A0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText"
                               Text="No downloads in this view.&#x0a;Use Add URL or the Chrome bridge to start one."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Foreground="#8C8C8C" FontSize="12" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#1B1B1B" BorderBrush="#333333" BorderThickness="0,1,0,0"
                Height="23">
            <Grid Padding="8,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Starting…" FontSize="11" Foreground="#A0A0A0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ConnectionText" Grid.Column="1" Text="Connecting…" FontSize="11"
                           Foreground="#A0A0A0" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
