    <Company>Private</Company>
    <Product>Inbound Download Manager</Product>
    <Copyright>Private use</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
