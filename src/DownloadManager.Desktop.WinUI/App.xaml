<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DownloadManager.Desktop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Single Inbound palette: every window/control resolves colors from here so dark and light stay consistent. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Selected list items: WinUI 3's subtle fills and primary text, per theme (Uno falls back to others). -->
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="TextFillColorPrimaryBrush" />
                    <!-- Mica shows through the window itself (InboundWindowBrush). App.xaml.cs makes it solid where Mica isn't
                         available. Chrome is a faint layer over it; the surface under lists stays opaque for reading. -->
                    <SolidColorBrush x:Key="InboundWindowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InboundChromeBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="InboundSurfaceBrush" Color="#181818" />
                    <SolidColorBrush x:Key="InboundDividerBrush" Color="#343434" />
                    <SolidColorBrush x:Key="InboundSecondaryTextBrush" Color="#A3A3A3" />
                    <SolidColorBrush x:Key="InboundProgressFillBrush" Color="#4AA3F0" />
                    <SolidColorBrush x:Key="InboundProgressTrackBrush" Color="#383838" />
                    <SolidColorBrush x:Key="InboundErrorTextBrush" Color="#F07A7A" />
                    <SolidColorBrush x:Key="InboundHighlightBrush" Color="#2B3A4F" />
                    <SolidColorBrush x:Key="InboundCategorySelectedBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="InboundCategorySelectedHoverBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="InboundIconStartBrush" Color="#8CCF8C" />
                    <SolidColorBrush x:Key="InboundIconPauseBrush" Color="#E8B36A" />
                    <SolidColorBrush x:Key="InboundIconDangerBrush" Color="#E08A8A" />
                    <SolidColorBrush x:Key="InboundIconInfoBrush" Color="#6FA8DC" />
                    <SolidColorBrush x:Key="InboundIconNeutralBrush" Color="#A8A8A8" />
                    <SolidColorBrush x:Key="InboundIconMediaBrush" Color="#B49AD6" />
                    <SolidColorBrush x:Key="InboundStatusActiveBrush" Color="#6DB3F2" />
                    <SolidColorBrush x:Key="InboundStatusDoneBrush" Color="#5DC879" />
                    <SolidColorBrush x:Key="InboundStatusFailedBrush" Color="#F58B8B" />
                    <SolidColorBrush x:Key="InboundStatusWaitingBrush" Color="#E0A93E" />
                    <SolidColorBrush x:Key="InboundStatusNeutralBrush" Color="#A3A3A3" />
                    <!-- Fluent layers: a card or tile lifted off the window, and its 1px edge. Translucent white in dark. -->
                    <SolidColorBrush x:Key="InboundCardBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="InboundCardStrokeBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="InboundWindowFallbackBrush" Color="#202020" />
                    <!-- UI.R32: My provider's drawer lies over the opaque list, where Mica can't show, so it frosts in the app. -->
                    <AcrylicBrush x:Key="InboundDrawerBrush" TintColor="#202020" TintOpacity="0.7" TintLuminosityOpacity="0.85" FallbackColor="#202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Selected list items: WinUI 3's subtle fills and primary text, per theme (Uno falls back to others). -->
                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="TextFillColorPrimaryBrush" />
                    <!-- UI.B21: light Mica takes the wallpaper's hue strongly (a teal cast beside the white lists), so light
                         windows lay an 85% veil of Mica's own neutral grey over it: still frosted, but neutral like dark. -->
                    <SolidColorBrush x:Key="InboundWindowBrush" Color="#D9F3F3F3" />
                    <SolidColorBrush x:Key="InboundChromeBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="InboundSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InboundDividerBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="InboundSecondaryTextBrush" Color="#666666" />
                    <SolidColorBrush x:Key="InboundProgressFillBrush" Color="#1F6FC5" />
                    <SolidColorBrush x:Key="InboundProgressTrackBrush" Color="#E2E2E2" />
                    <SolidColorBrush x:Key="InboundErrorTextBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="InboundHighlightBrush" Color="#DCE9F7" />
                    <SolidColorBrush x:Key="InboundCategorySelectedBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="InboundCategorySelectedHoverBrush" Color="#1E000000" />
                    <SolidColorBrush x:Key="InboundIconStartBrush" Color="#2E8B3E" />
                    <SolidColorBrush x:Key="InboundIconPauseBrush" Color="#B7791F" />
                    <SolidColorBrush x:Key="InboundIconDangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="InboundIconInfoBrush" Color="#1F6FC5" />
                    <SolidColorBrush x:Key="InboundIconNeutralBrush" Color="#6A6A6A" />
                    <SolidColorBrush x:Key="InboundIconMediaBrush" Color="#7B4FB8" />
                    <SolidColorBrush x:Key="InboundStatusActiveBrush" Color="#1B65B4" />
                    <SolidColorBrush x:Key="InboundStatusDoneBrush" Color="#1B7130" />
                    <SolidColorBrush x:Key="InboundStatusFailedBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="InboundStatusWaitingBrush" Color="#8A5A00" />
                    <SolidColorBrush x:Key="InboundStatusNeutralBrush" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="InboundCardBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="InboundCardStrokeBrush" Color="#13000000" />
                    <SolidColorBrush x:Key="InboundWindowFallbackBrush" Color="#F3F3F3" />
                    <AcrylicBrush x:Key="InboundDrawerBrush" TintColor="#F3F3F3" TintOpacity="0.7" TintLuminosityOpacity="0.85" FallbackColor="#F3F3F3" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Inbound blue replaces the user's Windows accent so checkboxes, primary buttons and selections match the palette. -->
            <Color x:Key="SystemAccentColor">#1F6FC5</Color>
            <Color x:Key="SystemAccentColorLight1">#3A86D6</Color>
            <Color x:Key="SystemAccentColorLight2">#4AA3F0</Color>
            <Color x:Key="SystemAccentColorLight3">#84BDF3</Color>
            <Color x:Key="SystemAccentColorDark1">#1A5FA8</Color>
            <Color x:Key="SystemAccentColorDark2">#144E8C</Color>
            <Color x:Key="SystemAccentColorDark3">#0E3C6E</Color>

            <Style x:Key="InboundProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource InboundProgressFillBrush}" />
                <Setter Property="Background" Value="{ThemeResource InboundProgressTrackBrush}" />
                <Setter Property="MinHeight" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>

            <Style x:Key="InboundToolButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="InboundToolSeparatorStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="6,10" />
                <Setter Property="Background" Value="{ThemeResource InboundDividerBrush}" />
            </Style>

            <!-- UI.R6: digits all the same width (tabular figures in the current font), so live counters such as size,
                 speed and time left hold still as their digits change. Applies to every TextBlock without a style. -->
            <Style TargetType="TextBlock">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <!-- UI.R6: a live counter beside its label. A box of fixed least width with the text on its right, so the
                 units stay put when the digit count changes. A longer value still fits: the box grows, and wraps if set. -->
            <Style x:Key="InboundCounterValueStyle" TargetType="TextBlock">
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                <Setter Property="MinWidth" Value="210" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <Style x:Key="InboundToolLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <!-- UI.R31: Progress Details' design language, for windows built in code (InboundUi). -->
            <Style x:Key="InboundCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InboundCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InboundCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <!-- A list framed as a card: the opaque reading surface inside a radius-8 edge. -->
            <Style x:Key="InboundListCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InboundSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InboundCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style x:Key="InboundTileStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InboundCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InboundCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="InboundPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="InboundSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="InboundSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource InboundSecondaryTextBrush}" />
            </Style>

            <Style x:Key="InboundCategoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="23" />
                <Setter Property="Padding" Value="8,2" />
                <!-- UI.R31: the selection is a rounded fill set in from the edges, not a square block. WinUI's own
                     ListBoxItem template ignores CornerRadius, so this one draws the same states on a rounded fill. -->
                <Setter Property="Margin" Value="4,1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SystemControlHighlightListMediumBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource InboundCategorySelectedBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedUnfocused">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource InboundCategorySelectedBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource InboundCategorySelectedBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource InboundCategorySelectedHoverBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource InboundCategorySelectedHoverBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlHighlightAltBaseHighBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="InboundListRowStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="27" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <Style x:Key="InboundHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="4,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
