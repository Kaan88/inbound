<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadManager.Desktop.WinUI.LocalPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI">
    <!-- SITES.5 / SITES.11 R2a: the "This PC" card of the Two panes view, with the same chrome as the server's. -->
    <!-- Top-aligned: the card ends after its last row (the list scrolls once it reaches the window's height). -->
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource InboundCardStrokeBrush}"
            Background="{ThemeResource InboundCardBrush}" VerticalAlignment="Top">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,10,12,4" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE80F;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="This PC" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
            </StackPanel>

            <local:PathBar x:Name="Bar" Grid.Row="1" />
            <local:PaneColumnHeader x:Name="Titles" Grid.Row="2" />

            <Grid x:Name="ListHost" Grid.Row="3">
                <ListView x:Name="ItemsList" SelectionMode="Extended" IsDoubleTapEnabled="True"
                          AutomationProperties.Name="Folder contents on this PC"
                          ItemContainerStyle="{StaticResource InboundListRowStyle}"
                          DoubleTapped="ItemsList_DoubleTapped" PreviewKeyDown="ItemsList_PreviewKeyDown"
                          SelectionChanged="ItemsList_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="27" Padding="10,0,10,0" ColumnSpacing="8" Background="Transparent"
                                  AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" VerticalAlignment="Center" Visibility="{Binding FolderVisibility}"
                                          Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" VerticalAlignment="Center" Visibility="{Binding FileVisibility}"
                                          Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                                           HorizontalTextAlignment="Right" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="MessageText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" TextWrapping="Wrap" MaxWidth="360"
                           FontSize="12" HorizontalTextAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
            </Grid>

            <Border Grid.Row="4" Padding="12,6" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="CountText" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
