<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorControlHighlight">
  <item>
    <selector>
      <item android:state_checked="true">
        <layer-list>
          <item android:width="64dp" android:height="32dp" android:gravity="top|center_horizontal" android:top="12dp">
            <shape android:shape="rectangle"><corners android:radius="16dp"/><solid android:color="?attr/colorSecondaryContainer"/></shape>
          </item>
        </layer-list>
      </item>
      <item><color android:color="@android:color/transparent"/></item>
    </selector>
  </item>
  <item android:id="@android:id/mask">
    <layer-list><item android:width="64dp" android:height="32dp" android:gravity="top|center_horizontal" android:top="12dp">
      <shape android:shape="rectangle"><corners android:radius="16dp"/><solid android:color="@android:color/white"/></shape>
    </item></layer-list>
  </item>
</ripple>
