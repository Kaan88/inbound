<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- minSdkVersion comes from SupportedOSPlatformVersion in the project (31; 30 only for -p:InboundTestBuild=true). -->
  <uses-sdk android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- First run offers Unrestricted battery use so long downloads are not stopped (the system asks the person; this only lets the app ask). -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <application android:label="Inbound" android:usesCleartextTraffic="true" android:allowBackup="false" android:enableOnBackInvokedCallback="true" android:theme="@style/AppTheme">
    <!-- Opens a finished download from its notification (paths: Resources/xml/file_paths.xml). -->
    <provider android:name="androidx.core.content.FileProvider" android:authorities="app.inbound.android.fileprovider" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
