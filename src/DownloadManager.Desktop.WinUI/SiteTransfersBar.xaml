<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadManager.Desktop.WinUI.SiteTransfersBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI">
    <!-- R3 (SITES.11): the Transfers bar of the Remote files view, in the speed graph's place. A slim bar that opens upward;
         opened it is a list with the download list's look: its header, row height, status colours and progress bars. A batch
         is one row that opens in place to its files. -->
    <!-- Opened (the mockup), the slim bar stays on top and the list is a framed card under it; the whole bar grows upward
         from the window's bottom edge, and its top edge is the strip that is dragged. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="BodyPanel" Grid.Row="1" Height="260" Visibility="Collapsed" Margin="6,0,6,6" Padding="0,6,0,0"
              Background="{ThemeResource InboundCardBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="1" CornerRadius="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="27" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,2,8,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The segmented control is built in code (the Two panes / Remote only look). -->
                <Border x:Name="TabHost" BorderThickness="1" CornerRadius="7" Padding="2" />
                <TextBlock x:Name="ErrorText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Assertive"
                           Foreground="{ThemeResource InboundIconDangerBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="RetryAllButton" Padding="12,4" FontSize="12" Visibility="Collapsed"
                            Click="RetryAllButton_Click" ToolTipService.ToolTip="Try the failed files of every transfer again">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Retry all" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearDoneButton" Padding="12,4" FontSize="12" Content="Clear done"
                            Click="ClearDoneButton_Click" ToolTipService.ToolTip="Remove every finished transfer from this list; the files stay where they are" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
                <Grid Padding="4,0" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="140" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="3*" MinWidth="0" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource InboundHeaderTextStyle}" Text="File Name" Margin="0,0,0,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource InboundHeaderTextStyle}" Text="Size" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Style="{StaticResource InboundHeaderTextStyle}" Text="Status" />
                    <TextBlock Grid.Column="3" Style="{StaticResource InboundHeaderTextStyle}" Text="Time left" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="4" Style="{StaticResource InboundHeaderTextStyle}" Text="Transfer rate" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="5" Style="{StaticResource InboundHeaderTextStyle}" Text="Description" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <ListView x:Name="RowsList" Grid.Row="2" SelectionMode="Extended" AutomationProperties.Name="Remote file transfers"
                      Background="{ThemeResource InboundSurfaceBrush}" BorderThickness="0"
                      ItemContainerStyle="{StaticResource InboundListRowStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      DoubleTapped="RowsList_DoubleTapped"
                      PreviewKeyDown="RowsList_PreviewKeyDown">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="27" Padding="4,0" ColumnSpacing="0" AutomationProperties.Name="{Binding AccessibleName}"
                              ToolTipService.ToolTip="{Binding ToolTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="140" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="3*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="{Binding Indent}" ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <!-- Auto: a row without a chevron has no gap for one. -->
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- A real button, so screen readers and UI Automation can open a batch (Invoke); flat, as the old chevron.
                                     Not a tab stop: the keyboard opens a batch with Right and Left. -->
                                <Button Width="22" Height="22" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="4" BorderThickness="0"
                                        Background="Transparent" VerticalAlignment="Center" IsTabStop="False"
                                        Visibility="{Binding ChevronVisibility}" Click="Chevron_Click" DoubleTapped="Chevron_DoubleTapped"
                                        ToolTipService.ToolTip="{Binding ChevronName}" AutomationProperties.Name="{Binding ChevronName}">
                                    <FontIcon Glyph="{Binding ChevronGlyph}" FontSize="11" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                                <FontIcon Grid.Column="1" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource InboundIconInfoBrush}"
                                          Visibility="{Binding DownArrowVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <FontIcon Grid.Column="1" Glyph="&#xE898;" FontSize="14" Foreground="{ThemeResource InboundUploadBrush}"
                                          Visibility="{Binding UpArrowVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Typography.NumeralAlignment="Tabular" Grid.Column="2" Text="{Binding Name}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBlock Typography.NumeralAlignment="Tabular" Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                                       HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Typography.NumeralAlignment="Tabular" Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{Binding Percent}" Maximum="100" Style="{StaticResource InboundListProgressBarStyle}" Margin="0,1,6,0"
                                             Visibility="{Binding DownBarVisibility}" />
                                <ProgressBar Value="{Binding Percent}" Maximum="100" Style="{StaticResource InboundListProgressBarStyle}" Margin="0,1,6,0"
                                             Foreground="{ThemeResource InboundUploadBrush}" Visibility="{Binding UpBarVisibility}" />
                            </StackPanel>
                            <TextBlock Typography.NumeralAlignment="Tabular" Grid.Column="3" Text="{Binding EtaText}" FontSize="11"
                                       HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Typography.NumeralAlignment="Tabular" Grid.Column="4" Text="{Binding RateText}" FontSize="11"
                                       HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Typography.NumeralAlignment="Tabular" Grid.Column="5" Text="{Binding Description}" FontSize="11" Margin="0,0,6,0"
                                       VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource InboundSecondaryTextBrush}" IsHitTestVisible="False" />
        </Grid>

        <Grid x:Name="SlimBar" Height="25" Margin="6,4,6,4" CornerRadius="6" Background="{ThemeResource InboundChromeBrush}"
              BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="1">
            <Grid.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            </Grid.Resources>
            <Button x:Name="ToggleButton" Click="ToggleButton_Click" AutomationProperties.Name="Transfers"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    MinHeight="0" Padding="8,0" BorderThickness="0" CornerRadius="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Transfers" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="{ThemeResource InboundIconInfoBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DownSpeedText" FontSize="11" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE898;" FontSize="11" Foreground="{ThemeResource InboundUploadBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="UpSpeedText" FontSize="11" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" Grid.Column="3" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                    <FontIcon x:Name="Chevron" Grid.Column="5" Glyph="&#xE70E;" FontSize="9" VerticalAlignment="Center"
                              Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                </Grid>
            </Button>
        </Grid>
        <!-- Drag this edge (the top of the opened bar) to change how tall the list is. -->
        <local:HeightGrip x:Name="HeightHandle" Height="5" VerticalAlignment="Top" Background="Transparent" Visibility="Collapsed"
                          Canvas.ZIndex="1" AutomationProperties.Name="Transfers height"
                          ToolTipService.ToolTip="Drag to change the height of the list" />
    </Grid>
</UserControl>
