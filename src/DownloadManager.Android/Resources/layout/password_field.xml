<?xml version="1.0" encoding="utf-8"?>
<!-- A masked field for the password sheets (t6, Saved passwords, TorBox key), outlined like Add torrent's fields. -->
<com.google.android.material.textfield.TextInputLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Inbound.NewDownload.Field" android:layout_width="match_parent" android:layout_height="wrap_content" app:endIconMode="password_toggle">
  <com.google.android.material.textfield.TextInputEditText android:id="@+id/password_input" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:inputType="textPassword|textNoSuggestions" android:imeOptions="actionDone" android:singleLine="true" android:importantForAutofill="no" />
</com.google.android.material.textfield.TextInputLayout>
