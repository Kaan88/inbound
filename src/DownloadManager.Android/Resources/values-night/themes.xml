<resources>
  <!-- Colour roles of the Figma board "How it works", section 5 (dark). -->
  <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="colorPrimary">#4AA3F0</item>
    <!-- Follows colorPrimary, so dynamic colour reaches radio buttons and switches too. -->
    <item name="colorControlActivated">?attr/colorPrimary</item>
    <!-- Inverse roles (snackbars) from the Inbound palette: the other theme's surface, text and primary. -->
    <item name="colorSurfaceInverse">#E6E6E6</item>
    <item name="colorOnSurfaceInverse">#1A1A1A</item>
    <item name="colorPrimaryInverse">#1F6FC5</item>
    <item name="colorOnPrimary">#0E1B2A</item>
    <item name="colorPrimaryContainer">#2B3A4F</item>
    <item name="colorOnPrimaryContainer">#D6E6FA</item>
    <item name="colorSecondaryContainer">#2B3A4F</item>
    <item name="colorOnSecondaryContainer">#D6E6FA</item>
    <item name="colorTertiary">#F0A35E</item>
    <item name="colorSurface">#181818</item>
    <item name="colorOnSurface">#F2F2F2</item>
    <item name="colorSurfaceVariant">#383838</item>
    <item name="colorOnSurfaceVariant">#A3A3A3</item>
    <item name="colorSurfaceContainer">#202020</item>
    <item name="colorSurfaceContainerLow">#202020</item>
    <item name="colorSurfaceContainerHigh">#2C2C2C</item>
    <item name="colorSurfaceContainerHighest">#383838</item>
    <item name="colorOutline">#6B6B6B</item>
    <item name="colorOutlineVariant">#343434</item>
    <item name="android:colorBackground">#181818</item>
    <item name="colorError">#F07A7A</item>
    <item name="bottomSheetDialogTheme">@style/InboundSheetDialog</item>
  </style>
  <style name="InboundSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
    <item name="android:windowAnimationStyle">@style/InboundSheetAnimation</item>
  </style>
  <style name="InboundSheetAnimation">
    <item name="android:windowEnterAnimation">@anim/sheet_in</item>
    <item name="android:windowExitAnimation">@anim/sheet_out</item>
  </style>
  <color name="state_done">#5DC879</color>
  <color name="state_failed">#F07A7A</color>
  <color name="state_waiting">#E0A93E</color>
  <color name="state_media">#B49AD6</color>
  <color name="state_done_container">#1D3A26</color>
  <color name="state_failed_container">#3D2323</color>
</resources>
