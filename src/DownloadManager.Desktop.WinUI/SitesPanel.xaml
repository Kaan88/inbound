<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadManager.Desktop.WinUI.SitesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI">
    <!-- SITES.3 / SITES.11 R2a: the browse view of one saved site as the mockup's card (browse, remote-only, trouble). -->
    <!-- Top-aligned: the card ends after its last row (the list scrolls once it reaches the window's height). -->
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource InboundCardStrokeBrush}"
            Background="{ThemeResource InboundCardBrush}" VerticalAlignment="Top">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The header: server icon, name, kind chip, "Not encrypted" chip. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,10,12,4" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE839;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="SiteNameText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" MaxWidth="260"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Border x:Name="KindChip" Visibility="Collapsed" CornerRadius="9" Padding="8,1" BorderThickness="1"
                        BorderBrush="{ThemeResource InboundStatusDoneBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="KindChipText" FontSize="11" Foreground="{ThemeResource InboundStatusDoneBrush}" />
                </Border>
                <!-- SITES.6: plain FTP and http:// sites say so where the files are. -->
                <Border x:Name="PlainChip" Visibility="Collapsed" CornerRadius="9" Padding="7,1" BorderThickness="1"
                        BorderBrush="{ThemeResource InboundErrorTextBrush}" VerticalAlignment="Center"
                        AutomationProperties.Name="Not encrypted"
                        ToolTipService.ToolTip="This site's connection is not encrypted: the password and the files can be read on the way.">
                    <TextBlock Text="Not encrypted" FontSize="11" Foreground="{ThemeResource InboundErrorTextBrush}" />
                </Border>
            </StackPanel>

            <local:PathBar x:Name="Bar" Grid.Row="1" />
            <local:PaneColumnHeader x:Name="Titles" Grid.Row="2" />

            <Grid x:Name="ListHost" Grid.Row="3">
                <ListView x:Name="ItemsList" SelectionMode="Extended" IsDoubleTapEnabled="True"
                          AutomationProperties.Name="Folder contents"
                          ItemContainerStyle="{StaticResource InboundListRowStyle}"
                          DoubleTapped="ItemsList_DoubleTapped"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="27" Padding="10,0,10,0" ColumnSpacing="8" Background="Transparent"
                                  AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" VerticalAlignment="Center" Visibility="{Binding FolderVisibility}"
                                          Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" VerticalAlignment="Center" Visibility="{Binding FileVisibility}"
                                          Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                                           HorizontalTextAlignment="Right" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                <!-- SITES.5: only for a site with a linked folder on this PC. Same green, older orange, others plain. -->
                                <Grid Grid.Column="4" Width="100" Visibility="{Binding HereVisibility}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding HereSameVisibility}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource InboundStatusDoneBrush}" />
                                        <TextBlock Text="{Binding HereText}" FontSize="12" Foreground="{ThemeResource InboundStatusDoneBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding HereText}" FontSize="12" Visibility="{Binding HereOlderVisibility}"
                                               Foreground="{ThemeResource InboundStatusWaitingBrush}" />
                                    <TextBlock Text="{Binding HereText}" FontSize="12" Visibility="{Binding HereOtherVisibility}"
                                               Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Loading, an empty folder, or trouble: one state in place of the list. -->
                <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="480" Margin="0,28"
                            Visibility="Collapsed">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" />
                    <FontIcon x:Name="TroubleIcon" Glyph="&#xE7BA;" FontSize="28" HorizontalAlignment="Center" Visibility="Collapsed"
                              Foreground="{ThemeResource InboundStatusWaitingBrush}" />
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed"
                               TextWrapping="Wrap" HorizontalTextAlignment="Center" />
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" HorizontalTextAlignment="Center" FontSize="12"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="RetryButton" Content="Retry now" Click="RetryButton_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="EditSiteButton" Content="Edit remote" Click="EditSiteButton_Click" />
                        <Button x:Name="OptionsButton" Content="Open Options > Sites" Click="OptionsButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="4" Padding="12,6" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                    <Button x:Name="MoreButton" Grid.Column="1" Visibility="Collapsed" Padding="10,2" Click="MoreButton_Click"
                            AutomationProperties.Name="Load more items" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
