<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadManager.Desktop.WinUI.RemoteFileTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectAllButton" Content="Select all" Click="SelectAll_Click" IsEnabled="False"
                    AutomationProperties.Name="Select all files" />
            <Button x:Name="SelectNoneButton" Grid.Column="1" Content="Select none" Click="SelectNone_Click" IsEnabled="False"
                    AutomationProperties.Name="Select no files" />
            <TextBlock x:Name="SummaryText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource InboundSecondaryTextBrush}" AutomationProperties.Name="Files selected"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <!-- UI.R31: framed as a card, as Progress Details frames its lists. -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource InboundCardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="4"
                Background="{ThemeResource InboundSurfaceBrush}">
            <Grid>
                <!-- No selection in the list itself: the checkboxes are the selection. Arrows move, Space
                     checks, Left and Right close and open a folder. -->
                <ListView x:Name="RowsList" SelectionMode="None" AutomationProperties.Name="Files"
                          ItemContainerStyle="{StaticResource InboundListRowStyle}"
                          PreviewKeyDown="RowsList_PreviewKeyDown"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="27" Padding="{Binding Indent}" ColumnSpacing="4" Background="Transparent"
                                  ToolTipService.ToolTip="{Binding AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <Button Width="20" Height="20" Padding="0" Background="Transparent" BorderThickness="0" IsTabStop="False"
                                        Visibility="{Binding ChevronVisibility}" Click="Chevron_Click"
                                        AutomationProperties.Name="{Binding ChevronName}">
                                    <FontIcon Glyph="{Binding ChevronGlyph}" FontSize="10"
                                              Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                </Button>
                                <CheckBox Grid.Column="1" MinWidth="0" MinHeight="0" Width="22" Height="22" Padding="0"
                                          VerticalAlignment="Center" IsThreeState="True"
                                          DataContextChanged="Check_DataContextChanged" Checked="Check_Changed" Unchecked="Check_Changed" Indeterminate="Check_Changed" IsEnabled="{Binding CanCheck}"
                                          AutomationProperties.Name="{Binding AccessibleName}" />
                                <FontIcon Grid.Column="2" Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"
                                          Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding Note}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                           Visibility="{Binding NoteVisibility}" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding Note}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                           Visibility="{Binding ProblemVisibility}" Foreground="{ThemeResource InboundErrorTextBrush}" />
                                <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Canvas x:Name="RegionLayer" IsHitTestVisible="False" />
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="16" FontSize="12" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                           AutomationProperties.Name="Files status" AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
