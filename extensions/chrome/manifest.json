{
  "manifest_version": 3,
  "name": "Inbound Download Manager Bridge",
  "version": "0.6.4",
  "description": "Sends browser downloads to the Inbound Download Manager desktop app for Windows, which must be installed separately.",
  "key": "",
  "minimum_chrome_version": "109",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Inbound Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": ["http://*/*", "https://*/*"]
}
