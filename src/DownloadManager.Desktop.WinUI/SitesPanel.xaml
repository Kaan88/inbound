<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadManager.Desktop.WinUI.SitesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SITES.3: the read-only browse view of one saved site, shown in place of the download list. -->
    <Grid Background="{ThemeResource InboundSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The path, one clickable part at a time, and the starred folders of the site. -->
        <Border Grid.Row="0" Padding="10,6" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1"
                Background="{ThemeResource InboundChromeBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SiteNameText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" MaxWidth="220"
                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <ScrollViewer Grid.Column="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                    <StackPanel x:Name="CrumbsPanel" Orientation="Horizontal" Spacing="2" AutomationProperties.Name="Path" />
                </ScrollViewer>
                <Button x:Name="StarredButton" Grid.Column="2" Padding="8,3" AutomationProperties.Name="Starred folders"
                        ToolTipService.ToolTip="Starred folders of this site">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource InboundIconPauseBrush}" />
                        <TextBlock Text="Starred" FontSize="12" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="StarredMenu" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Column titles, in the widths of a line. -->
        <Grid Grid.Row="1" Padding="10,4,10,4" ColumnSpacing="8" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource InboundHeaderTextStyle}" />
            <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource InboundHeaderTextStyle}" HorizontalTextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Modified" Style="{StaticResource InboundHeaderTextStyle}" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="ItemsList" SelectionMode="Single" IsDoubleTapEnabled="True"
                      AutomationProperties.Name="Folder contents"
                      ItemContainerStyle="{StaticResource InboundListRowStyle}"
                      DoubleTapped="ItemsList_DoubleTapped"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="27" Padding="10,0,10,0" ColumnSpacing="8" Background="Transparent"
                              AutomationProperties.Name="{Binding AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Glyph}" FontSize="15" VerticalAlignment="Center"
                                      Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                                       HorizontalTextAlignment="Right" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Loading, an error, or an empty folder: one message in place of the list. -->
            <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560"
                        Visibility="Collapsed">
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" HorizontalTextAlignment="Center" FontSize="13"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
                    <Button x:Name="OptionsButton" Content="Open Options" Click="OptionsButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Padding="10,4" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource InboundChromeBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                <Button x:Name="MoreButton" Grid.Column="1" Visibility="Collapsed" Padding="10,2" Click="MoreButton_Click"
                        AutomationProperties.Name="Load more items" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
