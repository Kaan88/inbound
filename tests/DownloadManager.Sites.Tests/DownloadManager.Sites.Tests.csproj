<Project Sdk="Microsoft.NET.Sdk">

  <!-- SITES.1: rclone as a child process. Tests that need a real rclone skip themselves, saying why, when none is found:
       INBOUND_RCLONE points at one (e.g. rclone 1.76.0 unpacked outside the repo). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="MSTest.EnableParentProcessQuery" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- rclone's own signed checksum list for 1.76.0 (public, from downloads.rclone.org). -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DownloadManager.Sites\DownloadManager.Sites.csproj" />
    <ProjectReference Include="..\..\tools\RcloneProbe\RcloneProbe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PpkWriter.cs" Link="Shared\PpkWriter.cs" />
  </ItemGroup>

</Project>
