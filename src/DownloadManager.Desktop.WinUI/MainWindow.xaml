<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DownloadManager.Desktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI"
    Title="Inbound Download Manager">

    <Grid x:Name="RootGrid" Background="{ThemeResource InboundWindowBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="QueueFileTemplate">
                <Grid ColumnSpacing="12" Padding="0,3" ToolTipService.ToolTip="{Binding FileName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}" Width="16" Height="16" />
                        <FontIcon Glyph="{Binding FileGlyph}" Visibility="{Binding FileGlyphVisibility}" FontSize="15" />
                        <FontIcon Glyph="{Binding FileGlyph}" Visibility="{Binding TorrentVisibility}" FontSize="15"
                                  Foreground="{ThemeResource InboundIconMediaBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" />
                    <TextBlock Grid.Column="3" Text="{Binding EtaText}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar x:Name="MainMenuBar" Grid.Row="0" Background="{ThemeResource InboundChromeBrush}" BorderThickness="0" Padding="4,1">
            <MenuBarItem x:Name="TasksMenu" Title="Tasks" AccessKey="T">
                <MenuFlyoutItem Text="Add URL…" AccessKey="N" Click="MenuAdd_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Add Links…" AccessKey="L" Click="MenuAddBatch_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Export Download List…" AccessKey="E" Click="MenuExport_Click" />
                <MenuFlyoutItem Text="Import Download List…" AccessKey="I" Click="MenuImport_Click" />
                <MenuFlyoutSeparator />
                <!-- UI.R26: filled from the saved servers each time it opens, like the switchers. -->
                <MenuFlyoutSubItem x:Name="TasksServersItem" Text="Show Downloads Of" AccessKey="S" />
                <MenuFlyoutItem Text="Web UI on This PC…" AccessKey="W" Click="MenuWebUi_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" AccessKey="X" Click="MenuExit_Click" />
            </MenuBarItem>

            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem x:Name="FileOpenItem" Text="Open" AccessKey="O" Click="MenuOpen_Click" />
                <MenuFlyoutItem x:Name="FileOpenFolderItem" Text="Open Folder" AccessKey="F" Click="MenuOpenFolder_Click" />
                <MenuFlyoutItem x:Name="FileMoveRenameItem" Text="Move/Rename…" AccessKey="M" AutomationProperties.AcceleratorKey="Ctrl+M" Click="MenuMoveRename_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FileProgressItem" Text="Progress Details…" AccessKey="P" Click="MenuProgressDetails_Click" />
                <MenuFlyoutItem x:Name="FileDownloadNowItem" Text="Resume" AccessKey="U" Click="MenuResume_Click" />
                <MenuFlyoutItem x:Name="FileStopItem" Text="Stop" AccessKey="S" Click="MenuPause_Click" />
                <!-- T1: shown while one torrent with a known file list is selected. -->
                <MenuFlyoutItem x:Name="FileChooseFilesItem" Text="Choose Files…" AccessKey="C" Visibility="Collapsed" Click="MenuChooseTorrentFiles_Click" />
                <!-- T2: shown while a selected torrent is finished and not seeding, or seeds. -->
                <MenuFlyoutItem x:Name="FileStartSeedingItem" Text="Start Seeding" AccessKey="G" Visibility="Collapsed" Click="MenuStartSeeding_Click" />
                <MenuFlyoutItem x:Name="FileStopSeedingItem" Text="Stop Seeding" AccessKey="T" Visibility="Collapsed" Click="MenuStopSeeding_Click" />
                <MenuFlyoutItem x:Name="FileRedownloadItem" Text="Redownload" AccessKey="R" Click="MenuRedownload_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FileDeleteItem" Text="Delete…" AccessKey="E" KeyboardAcceleratorTextOverride="Delete" Click="MenuDelete_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Servers…" AccessKey="V" Click="MenuServers_Click" />
                <MenuFlyoutItem Text="Web UI on This PC…" AccessKey="W" Click="MenuWebUi_Click" />
            </MenuBarItem>

            <MenuBarItem x:Name="DownloadsMenu" Title="Downloads" AccessKey="D">
                <MenuFlyoutItem Text="Stop All" AccessKey="S" Click="MenuStopAll_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete Completed" AccessKey="D" Click="MenuDeleteCompleted_Click" />
                <MenuFlyoutItem Text="Clean Up Leftover Partial Files…" AccessKey="L" Click="MenuCleanOrphans_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find…" AccessKey="F" Click="MenuFind_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Find Next" AccessKey="N" Click="MenuFindNext_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="StartQueueMenu" Text="Start Queue" AccessKey="Q" />
                <MenuFlyoutSubItem x:Name="StopQueueMenu" Text="Stop Queue" AccessKey="U" />
                <MenuFlyoutSeparator />
                <!-- UI.R15, UI.R16: the limits, each a submenu of common values; a choice applies at once. -->
                <MenuFlyoutSubItem x:Name="DownloadsLimitMenu" Text="Simultaneous Downloads" AccessKey="M" />
                <MenuFlyoutSubItem x:Name="ConnectionsLimitMenu" Text="Connections per Download" AccessKey="C" />
                <MenuFlyoutSubItem x:Name="SpeedLimitMenu" Text="Speed Limit" AccessKey="P" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Scheduler…" AccessKey="H" Click="MenuScheduler_Click" />
                <MenuFlyoutItem Text="Options…" AccessKey="T" Click="MenuOptions_Click" />
            </MenuBarItem>

            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Statistics…" AccessKey="S" Click="MenuStatistics_Click" />
                <ToggleMenuFlyoutItem x:Name="ShowSpeedGraphMenuItem" Text="Download Speed Graph" AccessKey="G" IsChecked="True" Click="MenuSpeedGraph_Click" />
                <ToggleMenuFlyoutItem x:Name="HideCategoriesMenuItem" Text="Hide Categories" AccessKey="C" Click="MenuHideCategories_Click" />
                <ToggleMenuFlyoutItem x:Name="TorrentInfoMenuItem" Text="Torrent Info" AccessKey="I" IsChecked="True" Click="MenuTorrentInfo_Click"
                                      ToolTipService.ToolTip="The selected torrent's facts beside the list, when the window is wide enough for its columns" />
                <MenuFlyoutSubItem Text="Arrange Files" AccessKey="A">
                    <MenuFlyoutItem Text="By Order of Addition" AccessKey="A" Tag="added" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By File Name" AccessKey="N" Tag="name" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Size" AccessKey="S" AutomationProperties.AcceleratorKey="Ctrl+Shift+S" Tag="size" Click="MenuSort_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="By Status" AccessKey="T" Tag="status" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Transfer Rate" AccessKey="R" Tag="rate" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Last Try Date" AccessKey="L" Tag="lastTry" Click="MenuSort_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Toolbar" AccessKey="T">
                    <MenuFlyoutItem Text="Large Buttons" AccessKey="L" Click="MenuLargeToolbar_Click" />
                    <MenuFlyoutItem Text="Small Buttons" AccessKey="S" Click="MenuSmallToolbar_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="DarkModeMenuItem" Text="Dark Mode" AccessKey="D" IsChecked="True" Click="MenuDarkMode_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem x:Name="WhatsNewMenuItem" Text="What's New…" AccessKey="W" Click="MenuWhatsNew_Click" />
                <MenuFlyoutItem Text="Check for Updates…" AccessKey="U" Click="MenuUpdate_Click" />
                <MenuFlyoutItem Text="Get the Browser Extension…" AccessKey="B" Click="MenuGetExtension_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Inbound Download Manager" AccessKey="A" Click="MenuAbout_Click" />
                <MenuFlyoutItem Text="Open Diagnostics Folder" AccessKey="D" Click="MenuDiagnostics_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,1">
            <Border.Resources>
            <ResourceDictionary>
                <!-- Toolbar buttons are flat: disabled ones only dim, they do not get a gray box. -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                <!-- Light mode's default hover is a near-white fill, invisible on the white toolbar. -->
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0F000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1A000000" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Padding="8,4" Spacing="0">
                    <Button x:Name="AddButton" AutomationProperties.Name="Add URL" Style="{StaticResource InboundToolButtonStyle}" Click="AddButton_Click"
                            ToolTipService.ToolTip="Add a new download URL">
                        <StackPanel>
                            <FontIcon Glyph="&#xE710;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Text="Add URL" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="ResumeButton" AutomationProperties.Name="Resume" Style="{StaticResource InboundToolButtonStyle}" Click="ResumeButton_Click"
                            ToolTipService.ToolTip="Resume the selected download">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="{ThemeResource InboundIconStartBrush}" />
                            <TextBlock Text="Resume" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" AutomationProperties.Name="Stop" Style="{StaticResource InboundToolButtonStyle}" Click="PauseButton_Click"
                            ToolTipService.ToolTip="Stop the selected download (partial data is kept)">
                        <StackPanel>
                            <FontIcon Glyph="&#xE769;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopAllButton" AutomationProperties.Name="Stop All" Style="{StaticResource InboundToolButtonStyle}" Click="MenuStopAll_Click"
                            ToolTipService.ToolTip="Stop all active downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop All" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="DeleteButton" AutomationProperties.Name="Delete" Style="{StaticResource InboundToolButtonStyle}" Click="DeleteButton_Click"
                            ToolTipService.ToolTip="Delete the selected download and its partial data">
                        <StackPanel>
                            <FontIcon Glyph="&#xE74D;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Delete" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteCompletedButton" AutomationProperties.Name="Delete Completed" Style="{StaticResource InboundToolButtonStyle}" Click="MenuDeleteCompleted_Click"
                            ToolTipService.ToolTip="Delete completed downloads from the list (their files stay)">
                        <StackPanel>
                            <FontIcon Glyph="&#xE894;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Delete Completed" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="OptionsButton" AutomationProperties.Name="Options"
                            Style="{StaticResource InboundToolButtonStyle}" Click="MenuOptions_Click"
                            ToolTipService.ToolTip="Open Inbound's options">
                        <StackPanel>
                            <FontIcon Glyph="&#xE713;" FontSize="25" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                            <TextBlock Text="Options" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SchedulerButton" AutomationProperties.Name="Scheduler" Style="{StaticResource InboundToolButtonStyle}"
                            Click="MenuScheduler_Click"
                            ToolTipService.ToolTip="Manage scheduled queue runs">
                        <StackPanel>
                            <FontIcon Glyph="&#xE787;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Text="Scheduler" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <!-- UI.R32: My provider as a drawer over the list's right side (Ctrl+T). Only while an account can be browsed. -->
                    <StackPanel x:Name="ProviderToolGroup" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="ProviderDrawerButton" Style="{StaticResource InboundToolButtonStyle}" Click="ProviderDrawerButton_Click"
                            AutomationProperties.AcceleratorKey="Ctrl+T">
                        <StackPanel>
                            <FontIcon Glyph="&#xE753;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock x:Name="ProviderDrawerLabel" Text="My provider" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="StartQueueButton" AutomationProperties.Name="Start Queue" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StartQueueButton_Click"
                            ToolTipService.ToolTip="Start the selected queue">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="{ThemeResource InboundIconStartBrush}" />
                            <TextBlock Text="Start Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopQueueButton" AutomationProperties.Name="Stop Queue" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StopQueueButton_Click"
                            ToolTipService.ToolTip="Stop the selected queue and its downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <!-- U-WL-6: last, so that showing it for a package moves no other button. -->
                    <StackPanel x:Name="CancelPackageGroup" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="CancelPackageButton" AutomationProperties.Name="Cancel Package" Style="{StaticResource InboundToolButtonStyle}" Click="MenuCancelPackage_Click"
                            ToolTipService.ToolTip="Cancel the unfinished files in the selected package (partial data is kept)">
                        <StackPanel>
                            <FontIcon Glyph="&#xE711;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Cancel Package" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
                <!-- UI.R26: which Host the window shows, at the right end of the toolbar so it stays in view however
                     narrow the window is. One click lists This PC and the saved servers; Ctrl+Shift+O opens it. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Padding="0,4,8,4">
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <DropDownButton x:Name="ToolbarServerSwitcher" Style="{StaticResource InboundToolButtonStyle}"
                                    AutomationProperties.Name="Show downloads of" AutomationProperties.AcceleratorKey="Ctrl+Shift+O"
                                    ToolTipService.ToolTip="Showing the downloads of this PC. Select to show another server's.">
                        <StackPanel>
                            <FontIcon x:Name="ToolbarServerIcon" Glyph="&#xE7F4;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock x:Name="ToolbarServerLabel" Text="This PC" MaxWidth="160" Style="{StaticResource InboundToolLabelStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="ToolbarServerMenu" Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
        <!-- UI.B18, U-WR-1, U-WR-3: while another server is shown, which one, whether it can be reached, and one click
             back to this PC (Ctrl+0). Hidden for this PC. -->
        <Border x:Name="ServerBannerBar" Visibility="Collapsed" Padding="10,4"
                Background="{ThemeResource InboundHighlightBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="ServerBannerIcon" Glyph="&#xE839;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource InboundIconInfoBrush}" />
                <TextBlock x:Name="ServerBannerText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.Name="Server shown" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ServerBannerButton" Grid.Column="2" FontSize="12" Padding="10,2" Visibility="Collapsed"
                        Click="ServerBannerAction_Click" />
                <Button x:Name="ServerBannerBack" Grid.Column="3" FontSize="12" Padding="10,2" Content="Back to This PC"
                        AutomationProperties.Name="Back to This PC" AutomationProperties.AcceleratorKey="Ctrl+0"
                        ToolTipService.ToolTip="Show the downloads of this PC (Ctrl+0)" Click="ServerBannerBack_Click" />
            </Grid>
        </Border>

        <!-- U-WL-8: while Find filters the list, what it shows and the way back to everything. -->
        <Border x:Name="FindBar" Visibility="Collapsed" Padding="10,4"
                Background="{ThemeResource InboundHighlightBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE71C;" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource InboundIconInfoBrush}" />
                <TextBlock x:Name="FindBarText" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Find filter" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="2" Content="Change…" FontSize="12" Padding="10,2"
                        AutomationProperties.Name="Change what Find looks for" Click="MenuFind_Click" />
                <Button Grid.Column="3" Content="Show all" FontSize="12" Padding="10,2"
                        AutomationProperties.Name="Clear the Find filter and show all downloads" Click="FindBarClear_Click" />
            </Grid>
        </Border>

        <!-- What extraction wants the user to know. It sits above the list and waits; nothing opens by itself. -->
        <Border x:Name="ArchiveNoticeBar" Visibility="Collapsed" Padding="10,4"
                Background="{ThemeResource InboundHighlightBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ArchiveNoticeText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Extraction notice" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="ArchiveNoticeAction" Grid.Column="1" FontSize="12" Padding="10,2" Click="ArchiveNoticeAction_Click" />
                <Button x:Name="ArchiveNoticeDismiss" Grid.Column="2" Content="Dismiss" FontSize="12" Padding="10,2"
                        AutomationProperties.Name="Dismiss this extraction notice" Click="ArchiveNoticeDismiss_Click" />
            </Grid>
        </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Categories" FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Margin="22,9,8,3" />
                    <ListBox x:Name="CategoryList" AutomationProperties.Name="Categories" Grid.Row="1" Background="Transparent"
                             BorderThickness="0" SelectionMode="Single"
                             SelectionChanged="CategoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource InboundCategoryItemStyle}">
                        <ListBox.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            </Style>
                        </ListBox.Resources>
                        <ListBoxItem Tag="all" AutomationProperties.Name="All Downloads" Padding="24,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="All Downloads" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="compressed" AutomationProperties.Name="Compressed" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <TextBlock Text="Compressed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="documents" AutomationProperties.Name="Documents" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource InboundIconInfoBrush}" />
                                <TextBlock Text="Documents" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="music" AutomationProperties.Name="Music" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource InboundIconMediaBrush}" />
                                <TextBlock Text="Music" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="programs" AutomationProperties.Name="Programs" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource InboundIconStartBrush}" />
                                <TextBlock Text="Programs" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="video" AutomationProperties.Name="Video" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{ThemeResource InboundIconDangerBrush}" />
                                <TextBlock Text="Video" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="other" AutomationProperties.Name="Other" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Other" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Content=" " IsEnabled="False" MinHeight="8" Padding="0" AutomationProperties.AccessibilityView="Raw" />
                        <ListBoxItem Tag="unfinished" AutomationProperties.Name="Unfinished" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Unfinished" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="active" AutomationProperties.Name="Active" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{ThemeResource InboundIconInfoBrush}" />
                                <TextBlock Text="Active" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="queued" AutomationProperties.Name="Queued" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <TextBlock Text="Queued" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="failed" AutomationProperties.Name="Failed" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource InboundIconDangerBrush}" />
                                <TextBlock Text="Failed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="finished" AutomationProperties.Name="Completed" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource InboundIconStartBrush}" />
                                <TextBlock Text="Completed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="queues" AutomationProperties.Name="Queues" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Queues" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <!-- UI.R32: My provider's drawer (C) is this split view's right pane: over the list, or docked beside it when
                 pinned and there is room. Its full view (A) covers the list's place in the content. -->
            <SplitView x:Name="ProviderSplit" Grid.Column="1" PanePlacement="Right" DisplayMode="Overlay" IsPaneOpen="False"
                       OpenPaneLength="420" LightDismissOverlayMode="Off" PaneBackground="{ThemeResource InboundDrawerBrush}"
                       PaneClosing="ProviderSplit_PaneClosing" PaneClosed="ProviderSplit_PaneClosed" SizeChanged="ProviderSplit_SizeChanged">
                <SplitView.Pane>
                    <Grid x:Name="ProviderDrawerFrame" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="1,0,0,0">
                        <Grid x:Name="ProviderDrawerHost" />
                        <local:ProviderDrawerGrip x:Name="ProviderDrawerGrip" Width="6" HorizontalAlignment="Left" Background="Transparent"
                                                  AutomationProperties.Name="Drawer width"
                                                  PointerPressed="ProviderDrawerGrip_PointerPressed" PointerMoved="ProviderDrawerGrip_PointerMoved"
                                                  PointerReleased="ProviderDrawerGrip_PointerReleased" PointerCaptureLost="ProviderDrawerGrip_PointerReleased"
                                                  DoubleTapped="ProviderDrawerGrip_DoubleTapped" />
                    </Grid>
                </SplitView.Pane>
            <Grid x:Name="ListArea" SizeChanged="ListArea_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- T7: the list, and the Torrent Info pane on its right (outside the list's sideways scroller). -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2">
                <!-- UI.R41: once, until Not now or until any extension connects (ExtensionPromoRules). -->
                <InfoBar x:Name="ExtensionHintBar" Severity="Informational" IsOpen="False" IsClosable="False" Margin="8,6,8,6"
                         AutomationProperties.Name="Get the browser extension" AutomationProperties.LiveSetting="Polite">
                    <InfoBar.ActionButton>
                        <Button x:Name="ExtensionHintGet" Content="Get it" FontSize="12" Padding="10,2" Click="ExtensionHintGet_Click"
                                ToolTipService.ToolTip="Shows where to get the extension for Chrome, Edge and Firefox" />
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button x:Name="ExtensionHintLater" Content="Not now" FontSize="12" Padding="10,2" Click="ExtensionHintLater_Click"
                                    ToolTipService.ToolTip="Hides this for good. Help > Get the Browser Extension has it." />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <!-- UI.R32, B's notice: what a Download from My provider added, with the way to it and back. -->
                <InfoBar x:Name="ProviderNoticeBar" Severity="Success" IsOpen="False" IsClosable="True" Margin="8,6,8,6"
                         AutomationProperties.Name="Added from My provider" AutomationProperties.LiveSetting="Polite">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button x:Name="ProviderNoticeShow" Content="Show" FontSize="12" Padding="10,2" Click="ProviderNoticeShow_Click"
                                    ToolTipService.ToolTip="Select these downloads in the list" />
                            <Button x:Name="ProviderNoticeBack" Content="Back to My provider" FontSize="12" Padding="10,2" Click="ProviderNoticeBack_Click" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                </StackPanel>
            <ScrollViewer x:Name="DownloadListViewport" Grid.Row="1"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="DownloadListGrid" Background="{ThemeResource InboundSurfaceBrush}" RowSpacing="0"
                  MinWidth="1040" Width="{Binding ViewportWidth, ElementName=DownloadListViewport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
                    <!-- Built in ColumnHeaderRow: a button that sorts and a grip that resizes, per column. -->
                    <Grid x:Name="JobsHeader" Padding="4,0" ColumnSpacing="0" />
                </Border>

                <Grid Grid.Row="1">

                    <ListView x:Name="JobsList"
                              AutomationProperties.Name="Downloads"
                              Background="{ThemeResource InboundSurfaceBrush}"
                              BorderThickness="0"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource InboundListRowStyle}"
                              SelectionChanged="JobsList_SelectionChanged"
                              KeyDown="JobsList_KeyDown"
                              PreviewKeyDown="JobsList_PreviewKeyDown"
                              DoubleTapped="JobsList_DoubleTapped"
                              RightTapped="JobsList_RightTapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Loaded="JobsList_Loaded">
                        <!-- No entrance/add animations: the list is rebuilt on expand, collapse and
                             view changes, and the default transition slid every row up from below. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="27" Padding="4,0" ColumnSpacing="0" Background="{Binding RowHighlight}"
                                      BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="{Binding RowBorder}"
                                      ToolTipService.ToolTip="{Binding RowToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.ColumnSpan="2" Width="30" HorizontalAlignment="Left" Margin="{Binding IconIndent}" Visibility="{Binding FileIconAreaVisibility}">
                                        <FontIcon Glyph="{Binding FileGlyph}" FontSize="15" Foreground="{ThemeResource InboundIconInfoBrush}"
                                                  Visibility="{Binding FileGlyphVisibility}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}"
                                               Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <!-- T1: a torrent row shows the swarm (or a link for a magnet still getting its file list). -->
                                        <FontIcon Glyph="{Binding FileGlyph}" FontSize="15" Foreground="{ThemeResource InboundIconMediaBrush}"
                                                  Visibility="{Binding TorrentGlyphVisibility}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                    <Border Tag="RowAction" Width="22" Height="22" CornerRadius="4" Background="Transparent"
                                            Visibility="{Binding ChevronVisibility}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Tapped="PackageChevron_Tapped" DoubleTapped="PackageChevron_DoubleTapped"
                                            PointerEntered="PackageChevron_PointerEntered"
                                            PointerExited="PackageChevron_PointerExited"
                                            ToolTipService.ToolTip="{Binding ChevronName}"
                                            AutomationProperties.Name="{Binding ChevronName}">
                                        <FontIcon Glyph="{Binding ChevronGlyph}" FontSize="11"
                                                  Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <!-- An open-able torrent row keeps its swarm glyph beside the chevron, before the name. -->
                                    <FontIcon Grid.Column="1" Glyph="{Binding FileGlyph}" FontSize="14" Foreground="{ThemeResource InboundIconMediaBrush}"
                                              Visibility="{Binding TorrentNameGlyphVisibility}" Width="16"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Margin="{Binding NameIndent}" Text="{Binding FileName}" FontSize="12" FontWeight="{Binding NameWeight}" FontStyle="{Binding NameStyle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding QueueText}" FontSize="11"
                                                VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                               ToolTipService.ToolTip="{Binding QueueName}" />
                                    <!-- UI.R6: live counters line up on the right in their fixed columns, with tabular figures, so
                                         the units hold still when the digit count changes. The margin matches the header's. -->
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11" AutomationProperties.AutomationId="SizeCell"
                                               HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Style="{StaticResource InboundProgressBarStyle}" Margin="0,1,6,0"
                                                     Visibility="{Binding ProgressVisibility}" />
                                        <!-- DT-6: a seeding torrent's way to its seeding goal (ratio or time, whichever comes first). -->
                                        <ProgressBar Value="{Binding SeedGoalPercent}" Maximum="100" Style="{StaticResource InboundProgressBarStyle}" Margin="0,1,6,0"
                                                     Foreground="{ThemeResource InboundStatusDoneBrush}" Visibility="{Binding SeedGoalVisibility}"
                                                     ToolTipService.ToolTip="{Binding SeedGoalToolTip}" />
                                    </StackPanel>
                                    <Grid Grid.Column="5" ColumnSpacing="4" Padding="0,0,6,0"
                                          Background="Transparent" ToolTipService.ToolTip="{Binding ArchiveToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ArchiveText}" FontSize="11" Foreground="{Binding ArchiveBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Width="22" Height="20" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0"
                                                Background="Transparent" VerticalAlignment="Center"
                                                Visibility="{Binding ArchivePasswordVisibility}" Click="ArchiveRowPassword_Click"
                                                ToolTipService.ToolTip="Enter the archive's password"
                                                AutomationProperties.Name="Enter the archive's password">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="12" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                        </Button>
                                    </Grid>
                                    <!-- DT-6: Seeds and Peers. The header shows and hides the cells of a column (UI.R42). -->
                                    <TextBlock Grid.Column="6" Text="{Binding SeedsText}" FontSize="11"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{Binding PeersText}" FontSize="11"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="8" Text="{Binding EtaText}" FontSize="11" AutomationProperties.AutomationId="EtaCell"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="9" Text="{Binding SpeedText}" FontSize="11" AutomationProperties.AutomationId="RateCell"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <!-- DT-6: Up and Ratio. -->
                                    <TextBlock Grid.Column="10" Text="{Binding UpText}" FontSize="11"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="11" Text="{Binding RatioText}" FontSize="11"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <!-- UI.R42: Uploaded, Seeding time and Seeding goal, where chosen from the header's menu. -->
                                    <TextBlock Grid.Column="12" Text="{Binding UploadedText}" FontSize="11"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="13" Text="{Binding SeedTimeText}" FontSize="11"
                                                HorizontalAlignment="Right" TextAlignment="Right" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="14" Text="{Binding SeedGoalText}" FontSize="11" Margin="0,0,6,0"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="15" Text="{Binding LastTryText}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="16" Text="{Binding Description}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- UI.R31: an empty view shows an outline glyph above its words; the glyph follows the words' visibility. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE896;" FontSize="32" HorizontalAlignment="Center"
                                  Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                  Visibility="{Binding Visibility, ElementName=EmptyText}" />
                        <TextBlock x:Name="EmptyText"
                                   Text="No downloads in this view.&#x0a;Use Add URL or the browser extension to start one."
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" FontSize="12" />
                    </StackPanel>
                    <Canvas x:Name="JobsRegionLayer" IsHitTestVisible="False" />
                </Grid>
            </Grid>
            </ScrollViewer>
            <!-- Always-visible scrollbar, outside the horizontal scroller so it stays at the right edge; kept in sync with the list's own ScrollViewer
                 (WinUI's built-in one collapses to a thin auto-hiding line). -->
            <Grid x:Name="JobsScrollTrack" Grid.Row="1" Width="12" HorizontalAlignment="Right" Margin="0,27,0,0" Visibility="Collapsed"
                  Background="{ThemeResource InboundChromeBrush}"
                  PointerPressed="JobsScrollTrack_PointerPressed"
                  PointerMoved="JobsScrollTrack_PointerMoved"
                  PointerReleased="JobsScrollTrack_PointerReleased"
                  PointerCaptureLost="JobsScrollTrack_PointerReleased"
                  PointerEntered="JobsScrollTrack_PointerEntered"
                  PointerExited="JobsScrollTrack_PointerExited"
                  SizeChanged="JobsScrollTrack_SizeChanged">
                <Border x:Name="JobsScrollThumb" VerticalAlignment="Top" Margin="3,0,3,0"
                        CornerRadius="3" Opacity="0.45"
                        Background="{ThemeResource InboundSecondaryTextBrush}" />
            </Grid>
            <!-- T7: Torrent Info (View > Torrent Info): the facts of the one selected torrent. Collapsed for anything else. -->
            <Border x:Name="TorrentInfoPane" Grid.Row="1" Grid.Column="1" Width="320" Visibility="Collapsed"
                    Background="{ThemeResource InboundSurfaceBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="1,0,0,0"
                    AutomationProperties.Name="Torrent info">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="27" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1"
                          Padding="10,0,2,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Torrent Info" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Width="24" Height="22" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0"
                                Background="Transparent" VerticalAlignment="Center" Click="TorrentInfoHide_Click"
                                ToolTipService.ToolTip="Hide Torrent Info. The View menu shows it again." AutomationProperties.Name="Hide Torrent Info">
                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12,10,12,12" Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="TorrentInfoName" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"
                                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="TorrentInfoStatus" FontSize="12" TextWrapping="Wrap" />
                                <ProgressBar x:Name="TorrentInfoBar" Maximum="100" Style="{StaticResource InboundProgressBarStyle}" Margin="0,2,0,0"
                                             AutomationProperties.Name="Downloaded" />
                                <TextBlock x:Name="TorrentInfoProgress" FontSize="11" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnSpacing="10" RowSpacing="5">
                                <Grid.Resources>
                                    <Style x:Key="InfoLabel" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Foreground" Value="{ThemeResource InboundSecondaryTextBrush}" />
                                        <Setter Property="Margin" Value="0,1,0,0" />
                                    </Style>
                                    <Style x:Key="InfoValue" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Down" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TorrentInfoDown" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="1" Text="Up" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TorrentInfoUp" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="2" Text="Connected" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TorrentInfoSwarm" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="3" Text="Time left" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TorrentInfoTimeLeft" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="4" Text="Ratio" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TorrentInfoRatio" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="5" x:Name="TorrentInfoGoalLabel" Text="Seeding goal" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TorrentInfoGoal" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="6" Text="Trackers" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TorrentInfoTrackers" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="7" Text="Save to" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TorrentInfoFolder" Style="{StaticResource InfoValue}" IsTextSelectionEnabled="True" />
                                <TextBlock Grid.Row="8" Text="Added" Style="{StaticResource InfoLabel}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TorrentInfoAdded" Style="{StaticResource InfoValue}" />
                                <TextBlock Grid.Row="9" Text="Info hash" Style="{StaticResource InfoLabel}" />
                                <Grid Grid.Row="9" Grid.Column="1" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TorrentInfoHash" Style="{StaticResource InfoValue}" FontFamily="Consolas" IsTextSelectionEnabled="True" />
                                    <Button x:Name="TorrentInfoCopyHash" Grid.Column="1" Width="24" Height="22" Padding="0" MinWidth="0" MinHeight="0" BorderThickness="0"
                                            Background="Transparent" VerticalAlignment="Top" Click="TorrentInfoCopyHash_Click"
                                            ToolTipService.ToolTip="Copy the info hash" AutomationProperties.Name="Copy the info hash">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <!-- Commands the row menu has too. -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="TorrentInfoOpenFolder" Content="Open Folder" FontSize="12" Padding="10,3" Click="TorrentInfoOpenFolder_Click" />
                                    <Button x:Name="TorrentInfoCopyMagnet" Content="Copy Magnet Link" FontSize="12" Padding="10,3" Click="MenuCopyMagnet_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="TorrentInfoRecheck" Content="Force Recheck" FontSize="12" Padding="10,3" Visibility="Collapsed"
                                            Click="MenuRecheck_Click" ToolTipService.ToolTip="Check the torrent's files on disk again" />
                                    <Button x:Name="TorrentInfoMore" Content="More details…" FontSize="12" Padding="10,3" Click="MenuProgressDetails_Click"
                                            ToolTipService.ToolTip="Open Progress Details: files, peers, trackers, pieces and options" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
                <!-- UI.R32, A: the sidebar's My provider entry shows the panel here, in place of the list. -->
                <Grid x:Name="ProviderFullHost" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" />
            </Grid>
            </SplitView>
        </Grid>

        <local:DownloadSpeedGraph x:Name="SpeedGraph" Grid.Row="4" />

        <Border Grid.Row="5" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,0"
                Height="23">
            <Grid Padding="2,0,8,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Which Host the window shows: This PC or a saved server (design D9, section 5). -->
                <DropDownButton x:Name="ServerSwitcher" Content="This PC" FontSize="11" Padding="6,0" MinHeight="0" Height="21"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                AutomationProperties.Name="Show downloads of" ToolTipService.ToolTip="Show the downloads of this PC or of another server">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ServerSwitcherMenu" Placement="TopEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting…" FontSize="11" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- Passing messages are announced here. StatusText changes on its own as counts move, so it isn't a live region. -->
                <TextBlock x:Name="StatusAnnouncer" Grid.Column="1" Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                           AutomationProperties.Name="Status message" AutomationProperties.LiveSetting="Polite" />
                <!-- T1: while a torrent downloads (the engine runs then). It opens the Torrents view. -->
                <Button x:Name="TorrentChip" Grid.Column="2" FontSize="11" Padding="8,0" MinHeight="0" Height="19" CornerRadius="9"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="TorrentChip_Click"
                        Foreground="{ThemeResource InboundSecondaryTextBrush}"
                        AutomationProperties.Name="Torrents"
                        ToolTipService.ToolTip="Show the Torrents view">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xF22C;" FontSize="11" Foreground="{ThemeResource InboundIconMediaBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TorrentChipText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- UI.R37: the version says whether it is the latest; a newer one is a link to Check for updates.
                     UPD.N1: with no update waiting, the version itself is the link, to What's new. -->

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionText" Text="Connecting…" FontSize="11"
                                Foreground="{ThemeResource InboundSecondaryTextBrush}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Name="UpdateLink" FontSize="11" Padding="0" MinHeight="0" VerticalAlignment="Center"
                                     Visibility="Collapsed" Click="UpdateLink_Click"
                                     AutomationProperties.Name="Update available"
                                     ToolTipService.ToolTip="Check for updates and install the new version" />
                    <TextBlock x:Name="ConnectionTail" FontSize="11" Visibility="Collapsed"
                                Foreground="{ThemeResource InboundSecondaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- U-WL-9: a browser registration that is broken or missing can be put right from here. -->
                <Button x:Name="RepairBrowserButton" Grid.Column="4" Content="Repair…" FontSize="11" Padding="8,0" MinHeight="0" Height="19"
                        VerticalAlignment="Center" Visibility="Collapsed" Click="RepairBrowser_Click"
                        AutomationProperties.Name="Repair browser integration"
                        ToolTipService.ToolTip="Register Inbound with your browsers again, so the extension can reach it" />
            </Grid>
        </Border>
    </Grid>
</Window>
