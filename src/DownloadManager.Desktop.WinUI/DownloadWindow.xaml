<Window
    x:Class="DownloadManager.Desktop.WinUI.DownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI">
    <Grid x:Name="Root" Padding="18" RowSpacing="10"
          Background="{ThemeResource InboundSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" Spacing="4">
            <TextBlock x:Name="Heading" Text="Connecting…" FontSize="21" FontWeight="SemiBold" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="FileIconHeader">
                    <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}" Width="24" Height="24" />
                    <FontIcon Glyph="{Binding FileGlyph}" Visibility="{Binding FileGlyphVisibility}" FontSize="20" />
                </Grid>
                <TextBlock x:Name="FileNameText" Grid.Column="1" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <TabView x:Name="DetailsTabs" Grid.Row="1" IsAddTabButtonVisible="False"
                 CanReorderTabs="False" TabWidthMode="Equal">
            <TabViewItem Header="Download status" IsClosable="False">
                <ScrollViewer x:Name="StatusScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Padding="4,8,10,10">
                        <TextBlock x:Name="UrlHeader" Text="URL" FontWeight="SemiBold" />
                        <TextBlock x:Name="UrlText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontSize="12" />
                        <local:JobDetailsPanel x:Name="Details" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Speed limiter" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12" Padding="4,12,10,10">
                        <!-- UI.R6: the rate holds a right edge of its own, so its units stay put as digits come and go. -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Current transfer rate:" />
                            <TextBlock x:Name="CurrentRateText" Text="—" MinWidth="80" TextAlignment="Right"
                                       AutomationProperties.Name="Current transfer rate" />
                        </StackPanel>
                        <CheckBox x:Name="UseSpeedLimit" Content="Use speed limiter" />
                        <TextBox x:Name="SpeedLimitInput" Header="Maximum download speed (KB/s)"
                                 PlaceholderText="Enter a positive number" IsEnabled="False" />
                        <TextBlock x:Name="SpeedLimitNotice"
                                   Text="Applies to ordinary HTTP/HTTPS and FTP file downloads. HLS and DASH transfers do not support this control."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="ApplySpeedLimitButton" Content="Apply speed limit"
                                HorizontalAlignment="Left" Click="ApplySpeedLimit_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Options on completion" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Padding="4,12,10,10">
                        <TextBlock Text="Save to" FontWeight="SemiBold" />
                        <TextBlock x:Name="CompletionPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <CheckBox x:Name="ShowCompletionForJob" Content="Show the completion window for this download"
                                  Click="ShowCompletionForJob_Click" />
                        <TextBlock Text="The global completion preference can be changed from the completion window."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <ScrollViewer x:Name="CompletionSummary" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
                <TextBlock x:Name="CompletedSize" />
                <TextBlock x:Name="CompletedUrlHeader" Text="Address" FontWeight="SemiBold" Margin="0,6,0,0" />
                <TextBox x:Name="CompletedUrl" IsReadOnly="True" />
                <TextBlock Text="The file saved as" FontWeight="SemiBold" />
                <TextBox x:Name="CompletedPath" IsReadOnly="True" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="Notice" Grid.Row="2" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <local:SegmentMapBar x:Name="SegmentMap" Grid.Row="3" Visibility="Collapsed" ToolTipService.ToolTip="Start positions and download progress by connection" />
        <ProgressBar x:Name="OverallFooter" Grid.Row="3" Maximum="100" IsIndeterminate="True" Style="{StaticResource InboundProgressBarStyle}" Height="14" MinHeight="14" CornerRadius="2" />

        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ActionRow" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" />
            <Button x:Name="ResumeButton" Content="Resume" Click="Resume_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" ToolTipService.ToolTip="Remove this download and delete its file" />
            <Button x:Name="OpenButton" Content="Open" Click="Open_Click" Visibility="Collapsed" />
            <Button x:Name="OpenWithButton" Content="Open with…" Click="OpenWith_Click" Visibility="Collapsed" />
            <Button x:Name="FolderButton" Content="Open folder" Click="Folder_Click" Visibility="Collapsed" />
            <Button x:Name="CloseButton" Content="Hide" Click="Close_Click" />
        </StackPanel>
        </ScrollViewer>
        <CheckBox x:Name="DontShowAgain" Grid.Row="5" Content="Don't show this dialog again" Visibility="Collapsed"
                  Click="DontShowAgain_Click" />
    </Grid>
</Window>
