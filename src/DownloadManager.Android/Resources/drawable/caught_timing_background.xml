<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_checked="true" android:state_focused="true">
    <inset android:insetTop="4dp" android:insetBottom="4dp"><shape><solid android:color="?attr/colorSecondaryContainer"/><stroke android:width="2dp" android:color="?attr/colorPrimary"/><corners android:radius="12dp"/></shape></inset>
  </item>
  <item android:state_focused="true">
    <inset android:insetTop="4dp" android:insetBottom="4dp"><shape><solid android:color="@android:color/transparent"/><stroke android:width="2dp" android:color="?attr/colorPrimary"/><corners android:radius="12dp"/></shape></inset>
  </item>
  <item android:state_checked="true">
    <inset android:insetTop="4dp" android:insetBottom="4dp"><shape><solid android:color="?attr/colorSecondaryContainer"/><corners android:radius="12dp"/></shape></inset>
  </item>
  <item>
    <inset android:insetTop="4dp" android:insetBottom="4dp"><shape><solid android:color="@android:color/transparent"/><stroke android:width="1dp" android:color="?attr/colorOutlineVariant"/><corners android:radius="12dp"/></shape></inset>
  </item>
</selector>
