<Project Sdk="Microsoft.NET.Sdk">

  <!-- T0: the contract library and the native worker (native/torrent-worker). Tests that need the worker binary skip
       themselves, saying why, when it has not been built; INBOUND_TORRENT_WORKER points at a build elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="MSTest.EnableParentProcessQuery" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DownloadManager.Torrents\DownloadManager.Torrents.csproj" />
  </ItemGroup>

</Project>
