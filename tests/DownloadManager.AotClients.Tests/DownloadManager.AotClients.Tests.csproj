<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PERF.10: the Native AOT clients (the CLI and the native host) have no reflection serializer. This project runs what they
    send and read with the same switch an AOT publish sets, so a type that only the reflection fallback knew fails here.
    The switch is process-wide, so nothing in this project may need reflection-based JSON (a test that compares with it builds
    its own options with an explicit DefaultJsonTypeInfoResolver, which the switch does not affect).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="MSTest.EnableParentProcessQuery" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DownloadManager.Core\DownloadManager.Core.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Contracts\DownloadManager.Contracts.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Cli\DownloadManager.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\JsonSampleFiller.cs" Link="Shared\JsonSampleFiller.cs" />
    <!-- The CLI's --json output pins, run here without reflection. -->
    <Compile Include="..\DownloadManager.Integration.Tests\CliJsonOutputTests.cs" Link="CliJsonOutputTests.cs" />
  </ItemGroup>

</Project>
