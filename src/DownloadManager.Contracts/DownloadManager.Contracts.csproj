<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- PERF.10: the trim and AOT analyzers only (no publish change); the warnings are the list for the Native AOT step. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- UPD.N1: the release notes the window and the web UI show after an update (docs\release-builds.md). -->
    <EmbeddedResource Include="Changelog\changelog.json" LogicalName="DownloadManager.Contracts.changelog.json" />
  </ItemGroup>

</Project>
