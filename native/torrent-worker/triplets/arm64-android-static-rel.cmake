# Static libraries, release only. Used by the phone's build (ANDROID.9): API 29, arm64-v8a, the NDK's static libc++.
set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Android)
set(VCPKG_CMAKE_SYSTEM_VERSION 29)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_MAKE_BUILD_TRIPLET "--host=aarch64-linux-android")
set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DANDROID_ABI=arm64-v8a -DANDROID_STL=c++_static)
set(VCPKG_CXX_FLAGS "-ffunction-sections -fdata-sections")
set(VCPKG_C_FLAGS "-ffunction-sections -fdata-sections")
