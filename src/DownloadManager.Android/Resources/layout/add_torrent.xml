<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/torrent_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:colorBackground">
  <LinearLayout android:id="@+id/torrent_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="8dp" android:paddingRight="8dp">
    <ImageButton android:id="@+id/torrent_close" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Close" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="8dp" android:text="Add torrent" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" android:accessibilityHeading="true" />
  </LinearLayout>
  <ScrollView android:id="@+id/torrent_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="16dp">
      <com.google.android.material.textfield.TextInputLayout android:id="@+id/magnet_layout" style="@style/Widget.Inbound.NewDownload.Field" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:hint="Magnet or .torrent file" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_file" app:endIconContentDescription="Choose a .torrent file">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/magnet" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri|textNoSuggestions" android:singleLine="true" android:ellipsize="end" android:importantForAutofill="no" />
      </com.google.android.material.textfield.TextInputLayout>

      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginLeft="4dp" android:text="Download with" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
      <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/with_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/with_phone" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="This phone" app:iconGravity="textStart" app:iconSize="16dp" app:iconPadding="6dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/with_torbox" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="TorBox" app:iconGravity="textStart" app:iconSize="16dp" app:iconPadding="6dp" />
      </com.google.android.material.button.MaterialButtonToggleGroup>
      <TextView android:id="@+id/with_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginLeft="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant" />

      <com.google.android.material.card.MaterialCardView android:id="@+id/status_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone"
          app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/state_done_container">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:minHeight="64dp">
          <ImageView android:id="@+id/status_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_flow_bolt" android:importantForAccessibility="no" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="14dp" android:orientation="vertical">
            <TextView android:id="@+id/status_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:textSize="15sp" android:textColor="?attr/colorOnSurface" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/status_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <TextView android:id="@+id/files_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginLeft="4dp" android:visibility="gone" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:accessibilityLiveRegion="polite" />
      <com.google.android.material.card.MaterialCardView android:id="@+id/files_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"
          app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="?attr/colorSurfaceContainer">
        <LinearLayout android:id="@+id/files_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp" />
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView android:id="@+id/miss_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone"
          app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/state_waiting_container">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="14dp">
          <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_flow_info" android:importantForAccessibility="no" app:tint="@color/state_waiting" />
          <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="14dp" android:orientation="vertical">
            <TextView android:id="@+id/miss_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:textSize="15sp" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/miss_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.textfield.TextInputLayout android:id="@+id/torrent_save_layout" style="@style/Widget.Inbound.NewDownload.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Save to"
          app:endIconMode="custom" app:endIconDrawable="@drawable/ic_new_download_folder" app:endIconCheckable="false" app:endIconTint="?attr/colorOnSurfaceVariant">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/torrent_save_to" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:singleLine="true" android:ellipsize="middle" android:textColor="?attr/colorOnSurface" />
      </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:id="@+id/torrent_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="?android:colorBackground" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="16dp" android:paddingBottom="16dp">
    <TextView android:id="@+id/torrent_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:visibility="gone" android:accessibilityLiveRegion="polite" android:textColor="?attr/colorError" android:textAppearance="?attr/textAppearanceBodyMedium" android:maxLines="4" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <com.google.android.material.button.MaterialButton android:id="@+id/torrent_cancel" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="56dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Cancel" app:cornerRadius="28dp" android:minWidth="96dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/torrent_send" android:layout_width="0dp" android:layout_height="56dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_weight="1" android:layout_marginLeft="12dp" android:text="Send to TorBox" app:icon="@drawable/ic_flow_bolt" app:iconGravity="textStart" app:iconSize="18dp" app:cornerRadius="28dp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
