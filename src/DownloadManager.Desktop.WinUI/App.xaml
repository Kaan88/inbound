<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DownloadManager.Desktop.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Single Inbound palette: every window/control resolves colors from here so dark and light stay consistent. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InboundChromeBrush" Color="#202020" />
                    <SolidColorBrush x:Key="InboundSurfaceBrush" Color="#181818" />
                    <SolidColorBrush x:Key="InboundDividerBrush" Color="#343434" />
                    <SolidColorBrush x:Key="InboundSecondaryTextBrush" Color="#A3A3A3" />
                    <SolidColorBrush x:Key="InboundProgressFillBrush" Color="#4AA3F0" />
                    <SolidColorBrush x:Key="InboundProgressTrackBrush" Color="#383838" />
                    <SolidColorBrush x:Key="InboundErrorTextBrush" Color="#F07A7A" />
                    <SolidColorBrush x:Key="InboundHighlightBrush" Color="#2B3A4F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InboundChromeBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="InboundSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="InboundDividerBrush" Color="#DADADA" />
                    <SolidColorBrush x:Key="InboundSecondaryTextBrush" Color="#666666" />
                    <SolidColorBrush x:Key="InboundProgressFillBrush" Color="#1F6FC5" />
                    <SolidColorBrush x:Key="InboundProgressTrackBrush" Color="#E2E2E2" />
                    <SolidColorBrush x:Key="InboundErrorTextBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="InboundHighlightBrush" Color="#DCE9F7" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="InboundProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{ThemeResource InboundProgressFillBrush}" />
                <Setter Property="Background" Value="{ThemeResource InboundProgressTrackBrush}" />
                <Setter Property="MinHeight" Value="6" />
                <Setter Property="Height" Value="6" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>

            <Style x:Key="InboundToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="86" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="InboundToolLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <Style x:Key="InboundCategoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="23" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="InboundListRowStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="27" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <Style x:Key="InboundHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="4,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
