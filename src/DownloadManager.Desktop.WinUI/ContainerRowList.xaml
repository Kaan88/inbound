<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadManager.Desktop.WinUI.ContainerRowList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI.R31: framed as a card, with each line's kind as a small chip. -->
    <Border BorderBrush="{ThemeResource InboundCardStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="4"
            Background="{ThemeResource InboundSurfaceBrush}">
        <!-- No selection in the list itself: the boxes are the selection. Arrows move and Space ticks. -->
        <ListView x:Name="RowsList" SelectionMode="None"
                  ItemContainerStyle="{StaticResource InboundListRowStyle}"
                  PreviewKeyDown="RowsList_PreviewKeyDown"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="27" Padding="{Binding Indent}" ColumnSpacing="4" Background="Transparent"
                          ToolTipService.ToolTip="{Binding AccessibleName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox MinWidth="0" MinHeight="0" Width="22" Height="22" Padding="0"
                                  VerticalAlignment="Top" Margin="0,3,0,0" IsThreeState="True"
                                  DataContextChanged="Check_DataContextChanged" Checked="Check_Changed" Unchecked="Check_Changed" Indeterminate="Check_Changed"
                                  IsEnabled="{Binding CanCheck}" Visibility="{Binding BoxVisibility}"
                                  AutomationProperties.Name="{Binding AccessibleName}" />
                        <StackPanel Grid.Column="1" Padding="0,5,0,5" Spacing="1">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis" />
                            <Border Visibility="{Binding WordVisibility}" HorizontalAlignment="Left" CornerRadius="10" BorderThickness="1"
                                    Padding="8,0,8,1" Margin="0,2,0,1" BorderBrush="{ThemeResource InboundSecondaryTextBrush}">
                                <TextBlock Text="{Binding Word}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            </Border>
                            <Border Visibility="{Binding ProblemVisibility}" HorizontalAlignment="Left" CornerRadius="10" BorderThickness="1"
                                    Padding="8,0,8,1" Margin="0,2,0,1" BorderBrush="{ThemeResource InboundErrorTextBrush}">
                                <TextBlock Text="{Binding Word}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource InboundErrorTextBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding DetailVisibility}" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Border>
</UserControl>
