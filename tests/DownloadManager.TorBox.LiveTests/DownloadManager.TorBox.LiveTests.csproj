<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests the real TorBoxClient against the real TorBox API. Opt-in twice over:
    it is built with the solution so it can't rot, but "dotnet test" finds nothing in it without
    -p:RunLiveTests=true, and each test skips itself, saying why, without TORBOX_API_KEY.
    Commands are in CLAUDE.md. scripts\test.ps1 doesn't list this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(RunLiveTests)' != 'true'">false</IsTestProject>
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="MSTest.EnableParentProcessQuery" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DownloadManager.Core\DownloadManager.Core.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Providers.TorBox\DownloadManager.Providers.TorBox.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Runtime\DownloadManager.Runtime.csproj" />
  </ItemGroup>

</Project>
