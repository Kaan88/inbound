<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadManager.Desktop.WinUI.LocalPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SITES.5: the "This PC" side of the Two panes view. A folder of this PC with Up, its path, Refresh and a list. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,6" ColumnSpacing="6" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="This PC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="UpButton" Grid.Column="1" Padding="6,2" Click="UpButton_Click" AutomationProperties.Name="Folder above on this PC"
                    ToolTipService.ToolTip="The folder above (Backspace)">
                <FontIcon Glyph="&#xE74A;" FontSize="12" />
            </Button>
            <TextBox x:Name="PathBox" Grid.Column="2" FontSize="12" MinHeight="0" Padding="6,3"
                     AutomationProperties.Name="Folder on this PC" KeyDown="PathBox_KeyDown"
                     ToolTipService.ToolTip="Type a folder and press Enter" />
            <Button x:Name="RefreshButton" Grid.Column="3" Padding="6,2" Click="RefreshButton_Click" AutomationProperties.Name="Read this PC folder again"
                    ToolTipService.ToolTip="Read the folder again (F5)">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="10,4,10,4" ColumnSpacing="8" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource InboundHeaderTextStyle}" />
            <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource InboundHeaderTextStyle}" HorizontalTextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Modified" Style="{StaticResource InboundHeaderTextStyle}" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="ItemsList" SelectionMode="Extended" IsDoubleTapEnabled="True"
                      AutomationProperties.Name="Folder contents on this PC"
                      ItemContainerStyle="{StaticResource InboundListRowStyle}"
                      DoubleTapped="ItemsList_DoubleTapped" PreviewKeyDown="ItemsList_PreviewKeyDown"
                      SelectionChanged="ItemsList_SelectionChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="27" Padding="10,0,10,0" ColumnSpacing="8" Background="Transparent"
                              AutomationProperties.Name="{Binding AccessibleName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Glyph}" FontSize="15" VerticalAlignment="Center"
                                      Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                                       HorizontalTextAlignment="Right" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="MessageText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       FontSize="12" HorizontalTextAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"
                       Foreground="{ThemeResource InboundSecondaryTextBrush}" />
        </Grid>
    </Grid>
</UserControl>
