<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DownloadManager.Desktop.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI"
    Title="Inbound Download Manager">

    <Grid x:Name="RootGrid" Background="{ThemeResource InboundSurfaceBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="QueueFileTemplate">
                <Grid ColumnSpacing="12" Padding="0,3" ToolTipService.ToolTip="{Binding FileName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}" Width="16" Height="16" />
                        <FontIcon Glyph="{Binding FileGlyph}" Visibility="{Binding FileGlyphVisibility}" FontSize="15" />
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" />
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" />
                    <TextBlock Grid.Column="3" Text="{Binding EtaText}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Background="{ThemeResource InboundChromeBrush}" BorderThickness="0" Padding="4,1">
            <MenuBarItem Title="Tasks">
                <MenuFlyoutItem Text="Add New Download…" Click="MenuAdd_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Add Links…" Click="MenuAddBatch_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Export Download List…" Click="MenuExport_Click" />
                <MenuFlyoutItem Text="Import Download List…" Click="MenuImport_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="MenuExit_Click" />
            </MenuBarItem>

            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open" Click="MenuOpen_Click" />
                <MenuFlyoutItem Text="Open Folder" Click="MenuOpenFolder_Click" />
                <MenuFlyoutItem Text="Move/Rename…" AutomationProperties.AcceleratorKey="Ctrl+M" Click="MenuMoveRename_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Progress Details…" Click="MenuProgressDetails_Click" />
                <MenuFlyoutItem Text="Download Now" Click="MenuResume_Click" />
                <MenuFlyoutItem Text="Stop Download" Click="MenuPause_Click" />
                <MenuFlyoutItem Text="Redownload" Click="MenuRedownload_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Remove" Click="MenuRemove_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Downloads">
                <MenuFlyoutItem Text="Stop All" Click="MenuStopAll_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete All Completed" Click="MenuDeleteCompleted_Click" />
                <MenuFlyoutItem Text="Clean Up Leftover Partial Files…" Click="MenuCleanOrphans_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Find…" Click="MenuFind_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Find Next" Click="MenuFindNext_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F3" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="StartQueueMenu" Text="Start Queue" />
                <MenuFlyoutSubItem x:Name="StopQueueMenu" Text="Stop Queue" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Scheduler…" Click="MenuScheduler_Click" />
                <MenuFlyoutItem Text="Options…" Click="MenuOptions_Click" />
            </MenuBarItem>

            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Statistics…" Click="MenuStatistics_Click" />
                <ToggleMenuFlyoutItem x:Name="ShowSpeedGraphMenuItem" Text="Download Speed Graph" IsChecked="True" Click="MenuSpeedGraph_Click" />
                <ToggleMenuFlyoutItem x:Name="HideCategoriesMenuItem" Text="Hide Categories" Click="MenuHideCategories_Click" />
                <MenuFlyoutSubItem Text="Arrange Files">
                    <MenuFlyoutItem Text="By Order of Addition" Tag="added" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By File Name" Tag="name" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Size" AutomationProperties.AcceleratorKey="Ctrl+Shift+S" Tag="size" Click="MenuSort_Click">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="By Status" Tag="status" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Transfer Rate" Tag="rate" Click="MenuSort_Click" />
                    <MenuFlyoutItem Text="By Last Try Date" Tag="lastTry" Click="MenuSort_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Toolbar">
                    <MenuFlyoutItem Text="Large Buttons" Click="MenuLargeToolbar_Click" />
                    <MenuFlyoutItem Text="Small Buttons" Click="MenuSmallToolbar_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="DarkModeMenuItem" Text="Dark Mode" IsChecked="True" Click="MenuDarkMode_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Check for Updates…" Click="MenuUpdate_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Inbound Download Manager" Click="MenuAbout_Click" />
                <MenuFlyoutItem Text="Open Diagnostics Folder" Click="MenuDiagnostics_Click" />
            </MenuBarItem>
        </MenuBar>

        <Border Grid.Row="1" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,1">
            <Border.Resources>
                <!-- Toolbar buttons are flat: disabled ones only dim, they do not get a gray box. -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            </Border.Resources>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal" Padding="8,4" Spacing="0">
                    <Button x:Name="AddButton" AutomationProperties.Name="Add URL" Style="{StaticResource InboundToolButtonStyle}" Click="AddButton_Click"
                            ToolTipService.ToolTip="Add a new download URL">
                        <StackPanel>
                            <FontIcon Glyph="&#xE710;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Text="Add URL" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="ResumeButton" AutomationProperties.Name="Resume" Style="{StaticResource InboundToolButtonStyle}" Click="ResumeButton_Click"
                            ToolTipService.ToolTip="Resume the selected download">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="{ThemeResource InboundIconStartBrush}" />
                            <TextBlock Text="Resume" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" AutomationProperties.Name="Stop" Style="{StaticResource InboundToolButtonStyle}" Click="PauseButton_Click"
                            ToolTipService.ToolTip="Stop the selected download (partial data is kept)">
                        <StackPanel>
                            <FontIcon Glyph="&#xE769;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopAllButton" AutomationProperties.Name="Stop All" Style="{StaticResource InboundToolButtonStyle}" Click="MenuStopAll_Click"
                            ToolTipService.ToolTip="Stop all active downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop All" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="DeleteButton" AutomationProperties.Name="Delete" Style="{StaticResource InboundToolButtonStyle}" Click="DeleteButton_Click"
                            ToolTipService.ToolTip="Delete the selected download and its partial data">
                        <StackPanel>
                            <FontIcon Glyph="&#xE74D;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Delete" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteCompletedButton" AutomationProperties.Name="Delete Completed" Style="{StaticResource InboundToolButtonStyle}" Click="MenuDeleteCompleted_Click"
                            ToolTipService.ToolTip="Remove completed downloads from the list">
                        <StackPanel>
                            <FontIcon Glyph="&#xE894;" FontSize="25" Foreground="{ThemeResource InboundIconDangerBrush}" />
                            <TextBlock Text="Delete Completed" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="OptionsButton" AutomationProperties.Name="Options"
                            Style="{StaticResource InboundToolButtonStyle}" Click="MenuOptions_Click"
                            ToolTipService.ToolTip="Open Download Manager settings">
                        <StackPanel>
                            <FontIcon Glyph="&#xE713;" FontSize="25" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                            <TextBlock Text="Options" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SchedulerButton" AutomationProperties.Name="Scheduler" Style="{StaticResource InboundToolButtonStyle}"
                            Click="MenuScheduler_Click"
                            ToolTipService.ToolTip="Manage scheduled queue runs">
                        <StackPanel>
                            <FontIcon Glyph="&#xE787;" FontSize="25" Foreground="{ThemeResource InboundIconInfoBrush}" />
                            <TextBlock Text="Scheduler" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource InboundToolSeparatorStyle}" />
                    <Button x:Name="StartQueueButton" AutomationProperties.Name="Start Queue" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StartQueueButton_Click"
                            ToolTipService.ToolTip="Start the selected queue">
                        <StackPanel>
                            <FontIcon Glyph="&#xE768;" FontSize="25" Foreground="{ThemeResource InboundIconStartBrush}" />
                            <TextBlock Text="Start Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopQueueButton" AutomationProperties.Name="Stop Queue" Style="{StaticResource InboundToolButtonStyle}"
                            Click="StopQueueButton_Click"
                            ToolTipService.ToolTip="Stop the selected queue and pause its downloads">
                        <StackPanel>
                            <FontIcon Glyph="&#xE71A;" FontSize="25" Foreground="{ThemeResource InboundIconPauseBrush}" />
                            <TextBlock Text="Stop Queue" Style="{StaticResource InboundToolLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Categories" FontSize="12" FontWeight="SemiBold"
                                Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" Margin="22,9,8,3" />
                    <ListBox x:Name="CategoryList" AutomationProperties.Name="Categories" Grid.Row="1" Background="Transparent"
                             BorderThickness="0" SelectionMode="Single"
                             SelectionChanged="CategoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource InboundCategoryItemStyle}">
                        <ListBox.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            </Style>
                        </ListBox.Resources>
                        <ListBoxItem Tag="all" Padding="24,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="All Downloads" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="compressed" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <TextBlock Text="Compressed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="documents" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" Foreground="{ThemeResource InboundIconInfoBrush}" />
                                <TextBlock Text="Documents" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="music" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource InboundIconMediaBrush}" />
                                <TextBlock Text="Music" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="programs" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource InboundIconStartBrush}" />
                                <TextBlock Text="Programs" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="video" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{ThemeResource InboundIconDangerBrush}" />
                                <TextBlock Text="Video" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="other" Padding="38,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Other" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Content=" " IsEnabled="False" MinHeight="8" Padding="0" />
                        <ListBoxItem Tag="unfinished" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Unfinished" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="active" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="{ThemeResource InboundIconInfoBrush}" />
                                <TextBlock Text="Active" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="queued" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{ThemeResource InboundIconPauseBrush}" />
                                <TextBlock Text="Queued" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="failed" Padding="30,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE783;" FontSize="13" Foreground="{ThemeResource InboundIconDangerBrush}" />
                                <TextBlock Text="Failed" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="finished" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource InboundIconStartBrush}" />
                                <TextBlock Text="Finished" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="queues" Padding="14,2,8,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource InboundIconNeutralBrush}" />
                                <TextBlock Text="Queues" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer x:Name="DownloadListViewport" Grid.Column="1"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid Background="{ThemeResource InboundSurfaceBrush}" RowSpacing="0"
                  MinWidth="1040" Width="{Binding ViewportWidth, ElementName=DownloadListViewport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="27" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
                    <Grid Padding="4,0" ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="" />
                        <TextBlock Grid.Column="1" Text="File Name" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="Q" Style="{StaticResource InboundHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="Time left" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="6" Text="Transfer rate" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="7" Text="Last Try Date" Style="{StaticResource InboundHeaderTextStyle}" />
                        <TextBlock Grid.Column="8" Text="Description" Style="{StaticResource InboundHeaderTextStyle}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ListView x:Name="JobsList"
                              AutomationProperties.Name="Downloads"
                              Background="{ThemeResource InboundSurfaceBrush}"
                              BorderThickness="0"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource InboundListRowStyle}"
                              SelectionChanged="JobsList_SelectionChanged"
                              KeyDown="JobsList_KeyDown"
                              DoubleTapped="JobsList_DoubleTapped"
                              RightTapped="JobsList_RightTapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!-- No entrance/add animations: the list is rebuilt on expand, collapse and
                             view changes, and the default transition slid every row up from below. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="27" Padding="{Binding RowPadding}" ColumnSpacing="0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="210" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Visibility="{Binding FileIconAreaVisibility}">
                                        <FontIcon Glyph="{Binding FileGlyph}" FontSize="15" Foreground="{ThemeResource InboundIconInfoBrush}"
                                                  Visibility="{Binding FileGlyphVisibility}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}"
                                               Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                    <Border Width="22" Height="22" CornerRadius="4" Background="Transparent"
                                            Visibility="{Binding ChevronVisibility}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Tapped="PackageChevron_Tapped" DoubleTapped="PackageChevron_DoubleTapped"
                                            PointerEntered="PackageChevron_PointerEntered"
                                            PointerExited="PackageChevron_PointerExited"
                                            ToolTipService.ToolTip="Expand or collapse"
                                            AutomationProperties.Name="Expand or collapse package">
                                        <FontIcon Glyph="{Binding ChevronGlyph}" FontSize="11"
                                                  Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" FontWeight="{Binding NameWeight}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding QueueText}" FontSize="11"
                                                VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                                               ToolTipService.ToolTip="{Binding QueueName}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Style="{StaticResource InboundProgressBarStyle}" Margin="0,1,6,0"
                                                     Visibility="{Binding ProgressVisibility}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding EtaText}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                    <TextBlock Grid.Column="6" Text="{Binding SpeedText}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{Binding LastTryText}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="8" Text="{Binding Description}" FontSize="11"
                                                VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText"
                               Text="No downloads in this view.&#x0a;Use Add URL or the browser extension to start one."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" FontSize="12" />
                </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>

        <Expander x:Name="SpeedGraphPanel" Grid.Row="3" ExpandDirection="Up" Header="Download speed · session history" IsExpanded="True"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <local:DownloadSpeedGraph x:Name="SpeedGraph" />
        </Expander>

        <Border Grid.Row="4" Background="{ThemeResource InboundChromeBrush}" BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,1,0,0"
                Height="23">
            <Grid Padding="8,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" AutomationProperties.Name="Status" Text="Starting…" FontSize="11" Foreground="{ThemeResource InboundSecondaryTextBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ConnectionText" AutomationProperties.Name="Host connection" Grid.Column="1" Text="Connecting…" FontSize="11"
                            Foreground="{ThemeResource InboundSecondaryTextBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
