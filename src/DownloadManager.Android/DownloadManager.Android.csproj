<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Inbound phone app. Not part of DownloadManager.slnx (the solution is built without the android workload):
       build it with scripts/build-android.ps1.
         emulator: Debug, default (Mono) runtime, android-x64
         phone:    Release, NativeAOT (dotnet publish), android-arm64
       -p:InboundTestBuild=true makes a TEST build: minimum Android 11 (API 30, so the Android 11 test phone can run it) and the
       adb test hooks (INBOUND_TEST_BUILD). A release build is never below API 31. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>app.inbound.android</ApplicationId>
    <ApplicationTitle>Inbound</ApplicationTitle>
    <ApplicationVersion>8</ApplicationVersion>
    <ApplicationDisplayVersion>0.0.8</ApplicationDisplayVersion>
    <RootNamespace>Inbound.App</RootNamespace>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416;CS1591;NU1701</NoWarn>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Owner, 2026-11-16: test builds may go down to API 30; release builds stay at 31. -->
  <!-- A test build has its own bin and obj folders, so its APK (with the hooks, minimum API 30) is never at a release APK's path. -->
  <PropertyGroup Condition="'$(InboundTestBuild)' == 'true'">
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);INBOUND_TEST_BUILD</DefineConstants>
    <OutputPath>bin\$(Configuration)-test\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)-test\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);INBOUND_RELEASE_ENV</DefineConstants>
  </PropertyGroup>

  <!-- The probe has its own package ID and hook; the standard arm64 Release bundles only the verified executable. -->
  <PropertyGroup Condition="'$(InboundRcloneProbePath)' != '' And '$(InboundTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);INBOUND_RCLONE_PROBE</DefineConstants>
    <ApplicationId>app.inbound.android.rcloneprobe</ApplicationId>
    <_InboundRcloneProbeAbi Condition="'$(RuntimeIdentifier)' == 'android-x64'">x86_64</_InboundRcloneProbeAbi>
    <_InboundRcloneProbeAbi Condition="'$(RuntimeIdentifier)' == 'android-arm64'">arm64-v8a</_InboundRcloneProbeAbi>
  </PropertyGroup>
  <ItemGroup Condition="'$(_InboundRcloneProbeAbi)' != ''">
    <AndroidNativeLibrary Include="$(InboundRcloneProbePath)" Abi="$(_InboundRcloneProbeAbi)" />
    <AndroidNativeLibraryNoJniPreload Include="librclone.so" />
  </ItemGroup>
  <Target Name="InboundCheckRcloneProbe" BeforeTargets="BeforeBuild" Condition="'$(InboundRcloneProbePath)' != ''">
    <Error Condition="'$(_InboundRcloneProbeAbi)' == '' Or '$(Configuration)' != 'Release'"
           Text="The rclone probe requires a Release NativeAOT android-x64 or android-arm64 test build." />
    <Error Condition="!Exists('$(InboundRcloneProbePath)') Or $([System.IO.Path]::GetFileName('$(InboundRcloneProbePath)')) != 'librclone.so'"
           Text="Supply the Android executable for the selected ABI as librclone.so." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == 'android-arm64' And '$(InboundTestBuild)' != 'true'">
    <_InboundBundleRclone>true</_InboundBundleRclone>
    <InboundRclonePath Condition="'$(InboundRclonePath)' == ''">$(MSBuildProjectDirectory)/../../artifacts/android-app/rclone/arm64-v8a/librclone.so</InboundRclonePath>
    <_InboundRcloneLicense>$(MSBuildProjectDirectory)/../../third_party/rclone/COPYING</_InboundRcloneLicense>
  </PropertyGroup>
  <ItemGroup Condition="'$(_InboundBundleRclone)' == 'true'">
    <AndroidNativeLibrary Include="$(InboundRclonePath)" Abi="arm64-v8a" />
    <AndroidNativeLibraryNoJniPreload Include="librclone.so" />
    <AndroidAsset Include="$(_InboundRcloneLicense)" Link="licenses/rclone.txt" />
  </ItemGroup>
  <Target Name="InboundCheckBundledRclone" BeforeTargets="BeforeBuild" Condition="'$(_InboundBundleRclone)' == 'true'">
    <Error Condition="!Exists('$(InboundRclonePath)') Or $([System.IO.Path]::GetFileName('$(InboundRclonePath)')) != 'librclone.so'"
           Text="The standard arm64 APK requires the pinned Android librclone.so. See third_party/rclone/SOURCE.md or set InboundRclonePath." />
    <GetFileHash Files="$(InboundRclonePath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_InboundRcloneActualSha256" />
    </GetFileHash>
    <Error Condition="'$(_InboundRcloneActualSha256)' != 'A68C72A4677E2BA27F1ED7C5B388EEA24B1088AD2BC389E461CC7A47C6195191'"
           Text="Bundled Android rclone SHA-256 mismatch: $(_InboundRcloneActualSha256). See third_party/rclone/SOURCE.md." />
  </Target>

  <!-- Debug (emulator): a self-contained APK that adb install can install, not the fast-deployment one. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- Release runtime environment (the sockets read this switch once, at first use). Also set in code by InboundApplication,
       because AndroidEnvironment is a Mono-runtime feature and may not reach a NativeAOT process. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidEnvironment Include="inbound-env.txt" />
  </ItemGroup>

  <Target Name="InboundCheckMinimumApi" BeforeTargets="BeforeBuild" Condition="'$(InboundTestBuild)' != 'true' And '$(SupportedOSPlatformVersion)' != '31'">
    <Error Text="Only a test build (-p:InboundTestBuild=true) may have a minimum Android version other than 31." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.13.0.2" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DownloadManager.Core\DownloadManager.Core.csproj" />
    <ProjectReference Include="..\DownloadManager.Contracts\DownloadManager.Contracts.csproj" />
    <ProjectReference Include="..\DownloadManager.Engine\DownloadManager.Engine.csproj" />
    <ProjectReference Include="..\DownloadManager.Persistence\DownloadManager.Persistence.csproj" />
    <ProjectReference Include="..\DownloadManager.Runtime\DownloadManager.Runtime.csproj" />
    <ProjectReference Include="..\DownloadManager.Mobile\DownloadManager.Mobile.csproj" />
  </ItemGroup>

  <!--
    HTTPS on NativeAOT (found 2026-11-17 on the S24: every https download failed with "secure connection failed").
    SslStream's Java trust manager (net.dot.android.crypto.DotnetProxyTrustManager) calls back into native code through
    the JNI function below. In the NativeAOT link nothing references it, so -gc-sections drops it and the generated
    version script does not export it: Java throws UnsatisfiedLinkError in checkServerTrusted and every TLS handshake
    fails. Keep it (undefined root) and add it to the exports list after ILC writes the list, before the native link.
    Remove once the Android SDK or ILCompiler does this itself.
  -->
  <PropertyGroup>
    <_InboundTlsJniSymbol>Java_net_dot_android_crypto_DotnetProxyTrustManager_verifyRemoteCertificate</_InboundTlsJniSymbol>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="-Wl,--undefined=$(_InboundTlsJniSymbol)" />
  </ItemGroup>
  <!-- Fails the build instead of shipping an APK whose TLS fails (Fable review, finding 2): no exports file, an exports file
       without the "global:" this edits, or a written file without the symbol are errors. A changed exports file deletes the
       native binary, so the link runs again even when LinkNative's own inputs (which don't include the exports file) are
       older than the .so, as in an obj built before this fix. After the link the .so's dynamic symbols must list it. -->
  <Target Name="_InboundExportTlsJniCallback" AfterTargets="IlcCompile" BeforeTargets="LinkNative"
          Condition="'$(PublishAot)' == 'true' and '$(TargetPlatformIdentifier)' == 'android'">
    <Error Condition="'$(ExportsFile)' == '' or !Exists('$(ExportsFile)')"
           Text="NativeAOT exports file not found ('$(ExportsFile)'): $(_InboundTlsJniSymbol) can't be exported, so every HTTPS connection would fail." />
    <PropertyGroup>
      <_InboundExports>$([System.IO.File]::ReadAllText('$(ExportsFile)'))</_InboundExports>
      <_InboundHasTlsExport>$(_InboundExports.Contains('$(_InboundTlsJniSymbol)'))</_InboundHasTlsExport>
    </PropertyGroup>
    <Error Condition="'$(_InboundHasTlsExport)' != 'True' and !$(_InboundExports.Contains('global:'))"
           Text="The NativeAOT exports file '$(ExportsFile)' has no 'global:' section to add $(_InboundTlsJniSymbol) to (the ILCompiler changed its format)." />
    <WriteLinesToFile File="$(ExportsFile)" Overwrite="true"
                      Lines="$(_InboundExports.Replace('global:', 'global:%0A        $(_InboundTlsJniSymbol);'))"
                      Condition="'$(_InboundHasTlsExport)' != 'True'" />
    <Delete Files="$(NativeBinary)" Condition="'$(_InboundHasTlsExport)' != 'True' and '$(NativeBinary)' != ''" />
    <PropertyGroup>
      <_InboundExportsAfter>$([System.IO.File]::ReadAllText('$(ExportsFile)'))</_InboundExportsAfter>
    </PropertyGroup>
    <Error Condition="!$(_InboundExportsAfter.Contains('$(_InboundTlsJniSymbol)'))"
           Text="$(_InboundTlsJniSymbol) is still missing from '$(ExportsFile)' after adding it." />
  </Target>

  <Target Name="_InboundCheckTlsJniExported" AfterTargets="LinkNative"
          Condition="'$(PublishAot)' == 'true' and '$(TargetPlatformIdentifier)' == 'android'">
    <Error Condition="'$(_NdkBinDir)' == '' or !Exists('$(NativeBinary)')"
           Text="Can't check the native library for $(_InboundTlsJniSymbol): NDK bin folder '$(_NdkBinDir)', library '$(NativeBinary)'." />
    <Exec Command="&quot;$(_NdkBinDir)llvm-readelf&quot; --dyn-syms --wide &quot;$(NativeBinary)&quot;" ConsoleToMSBuild="true" StandardOutputImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" ItemName="_InboundDynSyms" />
    </Exec>
    <ItemGroup>
      <!-- Defined here, not only named: an undefined (UND) entry would still fail at the first HTTPS connection. -->
      <_InboundTlsDefined Include="@(_InboundDynSyms)"
                          Condition="$([System.String]::Copy('%(Identity)').Contains('$(_InboundTlsJniSymbol)')) and !$([System.String]::Copy('%(Identity)').Contains(' UND '))" />
    </ItemGroup>
    <Error Condition="'@(_InboundTlsDefined)' == ''"
           Text="$(NativeBinary) does not export $(_InboundTlsJniSymbol) (llvm-readelf --dyn-syms): every HTTPS connection would fail. Delete the obj folder and build again." />
    <Message Importance="normal" Text="TLS callback exported: $(_InboundTlsJniSymbol) in $(NativeBinary)" />
  </Target>

</Project>
