<Window
    x:Class="DownloadManager.Desktop.WinUI.DownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadManager.Desktop.WinUI">
    <!-- UI.R29 direction B: a header, Overview / Connections / Options tabs, and the actions at the bottom right. -->
    <Grid x:Name="Root" Padding="20,16,20,16" RowSpacing="12"
          Background="{ThemeResource InboundWindowBrush}">
        <Grid.Resources>
            <Style x:Key="TileStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InboundCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InboundCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InboundCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource InboundCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="TileLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource InboundSecondaryTextBrush}" />
            </Style>
            <Style x:Key="TileValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="KeyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource InboundSecondaryTextBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the file's icon on a tile, its name and where it comes from, and the state. -->
        <Grid x:Name="Header" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource InboundCardBrush}"
                    BorderBrush="{ThemeResource InboundCardStrokeBrush}" BorderThickness="1">
                <Grid x:Name="FileIconHeader">
                    <Image Source="{Binding FileIcon}" Visibility="{Binding FileIconVisibility}" Width="24" Height="24" />
                    <FontIcon Glyph="{Binding FileGlyph}" Visibility="{Binding FileGlyphVisibility}" FontSize="20" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="FileNameText" Text="Connecting…" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="SubText" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
            </StackPanel>
            <Border x:Name="StateChip" Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="10,2,10,3"
                    BorderThickness="1" Background="{ThemeResource InboundCardBrush}">
                <TextBlock x:Name="Heading" Text="Connecting…" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <SelectorBar x:Name="Tabs" Grid.Row="1" Margin="-12,0,-12,0" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Name="OverviewTab" Text="Overview" IsSelected="True" />
            <SelectorBarItem x:Name="ConnectionsTab" Text="Connections" />
            <!-- T1: a torrent's files take the place of Connections, which a torrent doesn't have. -->
            <SelectorBarItem x:Name="FilesTab" Text="Files" Visibility="Collapsed" AutomationProperties.Name="Files" />
            <!-- T2: what a running torrent is connected to, read from the Host only while the tab shows. -->
            <SelectorBarItem x:Name="PeersTab" Text="Peers" Visibility="Collapsed" AutomationProperties.Name="Peers" />
            <SelectorBarItem x:Name="TrackersTab" Text="Trackers" Visibility="Collapsed" AutomationProperties.Name="Trackers" />
            <SelectorBarItem x:Name="PiecesTab" Text="Pieces &amp; Speed" Visibility="Collapsed" AutomationProperties.Name="Pieces and speed" />
            <SelectorBarItem x:Name="OptionsTab" Text="Options" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <!-- Overview: ring and tiles, the last minute's speed, a thin map of the file, and where it comes from and goes. -->
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Padding="0,0,12,4">
                    <!-- U-WL-3: why it failed comes first, before the ring and tiles. -->
                    <InfoBar x:Name="FailureBar" Severity="Error" IsClosable="False" IsOpen="False" AutomationProperties.Name="Why it failed" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="124" Height="124" VerticalAlignment="Center">
                            <ProgressRing x:Name="Ring" Width="124" Height="124" IsIndeterminate="False" Maximum="100"
                                          Background="{ThemeResource InboundProgressTrackBrush}"
                                          Foreground="{ThemeResource InboundProgressFillBrush}"
                                          AutomationProperties.Name="Download progress" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <FontIcon x:Name="RingGlyph" FontSize="32" Visibility="Collapsed" HorizontalAlignment="Center" />
                                <TextBlock x:Name="RingValue" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock x:Name="RingCaption" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" ColumnSpacing="8" RowSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="Tile1Label" Style="{StaticResource TileLabelStyle}" />
                                    <TextBlock Style="{StaticResource TileValueStyle}"><Run x:Name="Tile1Value" /><Run x:Name="Tile1Unit" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource InboundSecondaryTextBrush}" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="Tile2Label" Style="{StaticResource TileLabelStyle}" />
                                    <TextBlock Style="{StaticResource TileValueStyle}"><Run x:Name="Tile2Value" /><Run x:Name="Tile2Unit" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource InboundSecondaryTextBrush}" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="Tile3Label" Style="{StaticResource TileLabelStyle}" />
                                    <TextBlock Style="{StaticResource TileValueStyle}"><Run x:Name="Tile3Value" /><Run x:Name="Tile3Unit" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource InboundSecondaryTextBrush}" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="Tile4Label" Style="{StaticResource TileLabelStyle}" />
                                    <TextBlock Style="{StaticResource TileValueStyle}"><Run x:Name="Tile4Value" /><Run x:Name="Tile4Unit" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource InboundSecondaryTextBrush}" /></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- The main window's speed graph, for this download only: same drawing, scale, labels and hover. -->
                    <Border x:Name="SpeedPanel" Style="{StaticResource CardStyle}" Padding="0">
                        <local:DownloadSpeedGraph x:Name="Chart" />
                    </Border>

                    <local:SegmentMapBar x:Name="OverviewMap" Height="6" CornerRadius="3" Visibility="Collapsed"
                                         ToolTipService.ToolTip="Where in the file the downloaded parts are" />

                    <!-- T1: what a torrent has besides the usual: how it stands, its files and its info hash. -->
                    <!-- Each row after the first keeps its own 4 px above it, not RowSpacing: a hidden Seeding goal then leaves no gap. -->
                    <Grid x:Name="TorrentFacts" ColumnSpacing="12" Padding="2,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="TorrentStatusText" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Status" />
                        <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="Files" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="TorrentFilesText" Grid.Row="1" Margin="0,4,0,0" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Files" />
                        <TextBlock Grid.Row="2" Margin="0,4,0,0" Text="Info hash" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="InfoHashText" Grid.Row="2" Margin="0,4,0,0" Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" AutomationProperties.Name="Info hash" />
                        <!-- DT-10: what it has sent, and the seeding goal from Options with the time to it while it seeds. -->
                        <TextBlock Grid.Row="3" Margin="0,4,0,0" Text="Ratio" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="TorrentRatioText" Grid.Row="3" Margin="0,4,0,0" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Ratio" />
                        <TextBlock x:Name="SeedGoalHeader" Grid.Row="4" Margin="0,4,0,0" Text="Seeding goal" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="SeedGoalText" Grid.Row="4" Margin="0,4,0,0" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                   AutomationProperties.Name="Seeding goal" />
                        <!-- T3: what the Host says of the torrent (torrent.details), read while the Overview shows. -->
                        <TextBlock x:Name="AddedHeader" Grid.Row="5" Margin="0,4,0,0" Text="Added" Style="{StaticResource KeyStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="AddedText" Grid.Row="5" Margin="0,4,0,0" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" AutomationProperties.Name="Added" />
                        <TextBlock x:Name="PiecesHeader" Grid.Row="6" Margin="0,4,0,0" Text="Pieces" Style="{StaticResource KeyStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="PiecesFactText" Grid.Row="6" Margin="0,4,0,0" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" AutomationProperties.Name="Pieces" />
                        <TextBlock x:Name="WastedHeader" Grid.Row="7" Margin="0,4,0,0" Text="Wasted" Style="{StaticResource KeyStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="WastedText" Grid.Row="7" Margin="0,4,0,0" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" AutomationProperties.Name="Wasted"
                                   ToolTipService.ToolTip="Bytes downloaded twice or thrown away because a piece failed its check" />
                        <TextBlock x:Name="PrivateHeader" Grid.Row="8" Margin="0,4,0,0" Text="Private" Style="{StaticResource KeyStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="PrivateText" Grid.Row="8" Margin="0,4,0,0" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" AutomationProperties.Name="Private" />
                    </Grid>

                    <Grid x:Name="Facts" ColumnSpacing="12" RowSpacing="4" Padding="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="UrlHeader" Text="Address" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="UrlText" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                   IsTextSelectionEnabled="True" FontFamily="Consolas" />
                        <TextBlock x:Name="SavedHeader" Grid.Row="1" Text="Save to" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="SavedText" Grid.Row="1" Grid.Column="1" FontSize="12" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="ResumeHeader" Grid.Row="2" Text="Resume" Style="{StaticResource KeyStyle}" />
                        <TextBlock x:Name="ResumeText" Grid.Row="2" Grid.Column="1" FontSize="12" />
                    </Grid>

                    <!-- Finished: what to do with the file, Open first. -->
                    <StackPanel x:Name="CompletedActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="OpenButton" Style="{StaticResource AccentButtonStyle}" Click="Open_Click" Padding="16,7" MinWidth="110" AutomationProperties.Name="Open"
                                AutomationProperties.AcceleratorKey="Enter">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="14" /><TextBlock Text="Open" /></StackPanel>
                        </Button>
                        <Button x:Name="FolderButton" Click="Folder_Click" Padding="16,7" AutomationProperties.Name="Open Folder">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14" /><TextBlock Text="Open Folder" /></StackPanel>
                        </Button>
                        <Button x:Name="OpenWithButton" Content="Open With…" Click="OpenWith_Click" Padding="16,7" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Connections: one row per part of the file, with where it is and what it is doing. -->
            <Grid x:Name="ConnectionsPage" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="ConnectionsSummary" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConnectionsPercent" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ConnectionsBar" Grid.Column="1" Maximum="100" VerticalAlignment="Center" Style="{StaticResource InboundProgressBarStyle}" />
                    <TextBlock x:Name="ConnectionsLine" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Padding="0,0,12,0" Spacing="6">
                            <local:JobDetailsPanel x:Name="Details" />
                            <TextBlock x:Name="ConnectionsNote" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2">
                    <local:SegmentMapBar x:Name="SegmentMap" Visibility="Collapsed" ToolTipService.ToolTip="Start positions and download progress by connection" />
                    <ProgressBar x:Name="OverallFooter" Maximum="100" IsIndeterminate="True" Style="{StaticResource InboundProgressBarStyle}" Height="14" MinHeight="14" CornerRadius="2" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource InboundProgressFillBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Downloaded" FontSize="12" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource InboundProgressTrackBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Not yet downloaded" FontSize="12" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- T1 Files: a torrent's files, ticked for the ones it downloads. Virtualized: a torrent can hold 100,000 files.
                 T12: the header sorts and resizes as the download list's does (ColumnHeaderRow, built in DetailsTable). -->
            <Grid x:Name="FilesPage" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="FileChoiceBar" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Choose the files to download, then Start." TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="StartFilesButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="StartFiles_Click"
                            Padding="16,7" AutomationProperties.Name="Start" ToolTipService.ToolTip="Download the ticked files">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border x:Name="FilesCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4">
                    <!-- T12: wider columns than the card scroll sideways, header and rows together (DetailsTable sets the grid's widths). -->
                    <ScrollViewer x:Name="FilesSideways" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="FilesGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
                            <Grid x:Name="FilesHeader" Padding="4,0,8,0" ColumnSpacing="0" />
                        </Border>
                        <!-- No selection in the list itself: the boxes are the choice. Arrows move and Space ticks. -->
                        <ListView x:Name="FilesList" Grid.Row="1" SelectionMode="None" ItemContainerStyle="{StaticResource InboundListRowStyle}"
                                  PreviewKeyDown="FilesList_PreviewKeyDown" ContextRequested="FilesList_ContextRequested"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Files in this torrent">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- Widths come from the header (ColumnHeaderRow); the gaps are the cells' margins. -->
                                    <Grid MinHeight="27" ColumnSpacing="0" Padding="4,0,8,0" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox MinWidth="0" MinHeight="0" Width="22" Height="22" Padding="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" Click="FileBox_Click"
                                                  AutomationProperties.Name="{Binding AccessibleName}" />
                                        <TextBlock Grid.Column="1" Margin="4,0,8,0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Margin="0,0,12,0" Text="{Binding Size}" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource InboundSecondaryTextBrush}" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="3" Margin="0,0,12,0" Text="{Binding Progress}" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="4" Margin="4,0,8,0" Text="{Binding Priority}" Visibility="{Binding PriorityVisibility}"
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock x:Name="FilesNote" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                    <TextBlock x:Name="FilesPriorityHint" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource InboundSecondaryTextBrush}"
                               Text="Right-click a file to change its priority or skip it. A skipped file can still get a few bytes from pieces it shares with a file next to it." />
                </StackPanel>
            </Grid>

            <!-- T2 Peers: one row per connected peer. A peer is named by its place; its address is on hover. T12: sortable, resizable. -->
            <Grid x:Name="PeersPage" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="PeersCard" Style="{StaticResource CardStyle}" Padding="4">
                    <!-- T12: wider columns than the card scroll sideways, header and rows together (DetailsTable sets the grid's widths). -->
                    <ScrollViewer x:Name="PeersSideways" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="PeersGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
                            <Grid x:Name="PeersHeader" Padding="4,0,8,0" ColumnSpacing="0" />
                        </Border>
                        <ListView x:Name="PeersList" Grid.Row="1" SelectionMode="None" ItemContainerStyle="{StaticResource InboundListRowStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Peers of this torrent">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="27" ColumnSpacing="0" Padding="4,0,8,0" Background="Transparent"
                                          ToolTipService.ToolTip="{Binding Address}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="4,0,8,0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="4,0,8,0" Text="{Binding Client}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                        <TextBlock Grid.Column="2" Margin="4,0,8,0" Text="{Binding Flags}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                        <TextBlock Grid.Column="3" Margin="0,0,12,0" Text="{Binding Has}" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="4" Margin="0,0,12,0" Text="{Binding Down}" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="5" Margin="0,0,12,0" Text="{Binding Up}" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="PeersNote" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource InboundSecondaryTextBrush}"
                           Text="Peers see the public IP address of the computer that downloads, and it sees theirs; that is how BitTorrent works." />
            </Grid>

            <!-- T2 Trackers: what each tracker said last. What the tracker said in words is on hover. T12: sortable, resizable. -->
            <Grid x:Name="TrackersPage" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="TrackersCard" Style="{StaticResource CardStyle}" Padding="4">
                    <!-- T12: wider columns than the card scroll sideways, header and rows together (DetailsTable sets the grid's widths). -->
                    <ScrollViewer x:Name="TrackersSideways" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="TrackersGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{ThemeResource InboundDividerBrush}" BorderThickness="0,0,0,1">
                            <Grid x:Name="TrackersHeader" Padding="4,0,8,0" ColumnSpacing="0" />
                        </Border>
                        <ListView x:Name="TrackersList" Grid.Row="1" SelectionMode="None" ItemContainerStyle="{StaticResource InboundListRowStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Trackers of this torrent">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="27" ColumnSpacing="0" Padding="4,0,8,0" Background="Transparent"
                                          ToolTipService.ToolTip="{Binding Message}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="108" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="4,0,8,0" Text="{Binding Tracker}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="4,0,8,0" Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Margin="0,0,12,0" Text="{Binding Seeds}" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="3" Margin="0,0,12,0" Text="{Binding Peers}" FontSize="12" TextAlignment="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Column="4" Margin="0,0,12,0" Text="{Binding NextAnnounce}" Visibility="{Binding NextAnnounceVisibility}"
                                                   FontSize="12" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="TrackersNote" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource InboundSecondaryTextBrush}"
                           Text="A tracker's address is shown without what follows its name, where a private tracker keeps your passkey." />
            </Grid>

            <!-- T2 Pieces & Speed: which pieces the torrent has, and its speed while this tab shows. -->
            <ScrollViewer x:Name="PiecesPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="10" Padding="0,0,12,4">
                    <TextBlock Text="Pieces" Style="{StaticResource InboundSectionTitleStyle}" />
                    <local:TorrentPiecesBar x:Name="PiecesBar" AutomationProperties.Name="Pieces this torrent has" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource InboundProgressFillBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Have" FontSize="12" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource InboundProgressTrackBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Missing" FontSize="12" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="PiecesSummaryText" FontSize="12" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <local:DownloadSpeedGraph x:Name="TorrentChart" />
                    </Border>
                    <TextBlock x:Name="TorrentSpeedText" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="PiecesNote" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Options: this download's speed limit, what happens when it finishes, and where it goes. -->
            <Grid x:Name="OptionsPage" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OptionsPercent" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressBar x:Name="OptionsBar" Grid.Column="1" Maximum="100" VerticalAlignment="Center" Style="{StaticResource InboundProgressBarStyle}" />
                    <TextBlock x:Name="OptionsLine" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Padding="0,0,12,4">
                        <!-- T3: a torrent's own limits, seeding goal and order (torrent.options), in place of the speed limit below. -->
                        <Border x:Name="TorrentOptionsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Speed limits for this torrent" Style="{StaticResource InboundSectionTitleStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="TorrentDownloadLimited" Content="Limit downloading to" MinWidth="170" VerticalAlignment="Center"
                                              Click="TorrentLimit_Click" />
                                    <NumberBox x:Name="TorrentDownloadLimit" Width="120" Minimum="1" Maximum="2097151" PlaceholderText="KB/s"
                                               ValidationMode="Disabled" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"
                                               AutomationProperties.Name="Download limit for this torrent in KB/s" />
                                    <TextBlock Text="KB/s" VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="TorrentUploadLimited" Content="Limit uploading to" MinWidth="170" VerticalAlignment="Center"
                                              Click="TorrentLimit_Click" />
                                    <NumberBox x:Name="TorrentUploadLimit" Width="120" Minimum="1" Maximum="2097151" PlaceholderText="KB/s"
                                               ValidationMode="Disabled" SpinButtonPlacementMode="Hidden" VerticalAlignment="Center"
                                               AutomationProperties.Name="Upload limit for this torrent in KB/s" />
                                    <TextBlock Text="KB/s" VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="Seeding" Style="{StaticResource InboundSectionTitleStyle}" Margin="0,4,0,0" />
                                <RadioButtons x:Name="TorrentGoal" Header="Stop seeding at" SelectionChanged="TorrentGoal_SelectionChanged"
                                              AutomationProperties.Name="Stop seeding at">
                                    <x:String>Global goal</x:String>
                                    <x:String>Ratio</x:String>
                                    <x:String>Time</x:String>
                                    <x:String>Never seed</x:String>
                                </RadioButtons>
                                <StackPanel x:Name="TorrentGoalValueRow" Orientation="Horizontal" Spacing="10" Margin="28,0,0,0" Visibility="Collapsed">
                                    <NumberBox x:Name="TorrentGoalValue" Width="120" ValidationMode="Disabled" SpinButtonPlacementMode="Compact"
                                               VerticalAlignment="Center" AutomationProperties.Name="Seeding goal" />
                                    <TextBlock x:Name="TorrentGoalUnit" VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="Download order" Style="{StaticResource InboundSectionTitleStyle}" Margin="0,4,0,0" />
                                <CheckBox x:Name="TorrentSequential" Content="Download in order, first piece first (to watch it while it downloads)" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TorrentOptionsNote" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource InboundSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"
                                               Text="The total speed limit in Options › Connection covers torrents too." />
                                    <Button x:Name="TorrentOptionsApply" Grid.Column="1" Content="Apply" Click="TorrentOptionsApply_Click"
                                            VerticalAlignment="Center" AutomationProperties.Name="Apply this torrent's options" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SpeedLimitCard" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Speed limit" Style="{StaticResource InboundSectionTitleStyle}" />
                                <!-- UI.R6: the rate holds a right edge of its own, so its units stay put as digits come and go. -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Current transfer rate:" FontSize="12" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                    <TextBlock x:Name="CurrentRateText" Text="—" MinWidth="80" FontSize="12" TextAlignment="Right"
                                               AutomationProperties.Name="Current transfer rate" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox x:Name="UseSpeedLimit" Content="Limit this download to" VerticalAlignment="Center" />
                                    <TextBox x:Name="SpeedLimitInput" Width="120" PlaceholderText="KB/s" IsEnabled="False" VerticalAlignment="Center"
                                             AutomationProperties.Name="Maximum download speed in KB/s" />
                                    <TextBlock Text="KB/s" VerticalAlignment="Center" Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                    <Button x:Name="ApplySpeedLimitButton" Content="Apply" Click="ApplySpeedLimit_Click" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="SpeedLimitNotice"
                                           Text="Applies to ordinary HTTP/HTTPS and FTP file downloads. HLS and DASH transfers do not support this control."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="CompletionCard" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="When it finishes" Style="{StaticResource InboundSectionTitleStyle}" />
                                <CheckBox x:Name="ShowCompletionForJob" Content="Show the completion window for this download"
                                          Click="ShowCompletionForJob_Click" />
                                <TextBlock Text="For every download, this is in Options &gt; Downloads, under When a download finishes."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Save to" Style="{StaticResource InboundSectionTitleStyle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Foreground="{ThemeResource InboundSecondaryTextBrush}" />
                                    <TextBlock x:Name="CompletionPath" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="Notice" Grid.Row="3" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource InboundSecondaryTextBrush}" />

        <!-- A torrent's extra buttons (seeding, recheck, announce) leave the box no room beside them: it goes above them then. -->
        <!-- T13: the buttons are in a star column so their row can wrap onto a line above when the window is narrower than
             they are (ActionRowPanel); the box keeps the width it needs. -->
        <Grid x:Name="Footer" Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="DontShowAgain" Content="Don't show this window again" Visibility="Collapsed"
                      Click="DontShowAgain_Click" VerticalAlignment="Center" />
            <local:ActionRowPanel x:Name="ActionRow" Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <!-- U-WL-17: Delete first and set apart, so it is never next to the default action. -->
                <Button x:Name="DeleteButton" Click="Delete_Click" Margin="0,0,16,0" AutomationProperties.Name="Delete" ToolTipService.ToolTip="Remove this download and delete its file">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource InboundIconDangerBrush}" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <!-- T2: a finished torrent starts or stops seeding here as from the list. -->
                <Button x:Name="SeedButton" Click="Seed_Click" Visibility="Collapsed" AutomationProperties.Name="Stop seeding">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="SeedGlyph" Glyph="&#xE898;" FontSize="14" />
                        <TextBlock x:Name="SeedLabel" Text="Stop seeding" />
                    </StackPanel>
                </Button>
                <!-- T3: check the files on disk again; ask the trackers for peers now (shown on the Trackers tab). -->
                <Button x:Name="RecheckButton" Click="Recheck_Click" Visibility="Collapsed" AutomationProperties.Name="Force recheck"
                        ToolTipService.ToolTip="Check this torrent's files on disk again">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D5;" FontSize="14" />
                        <TextBlock Text="Force recheck" />
                    </StackPanel>
                </Button>
                <Button x:Name="AnnounceButton" Click="Announce_Click" Visibility="Collapsed" AutomationProperties.Name="Announce now"
                        ToolTipService.ToolTip="Ask the trackers for peers now">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Announce now" />
                    </StackPanel>
                </Button>
                <!-- U-WL-15: Stop, as the toolbar and the menus say it. The partial data is kept. -->
                <Button x:Name="PauseButton" Click="Pause_Click" AutomationProperties.Name="Stop" ToolTipService.ToolTip="Stop this download (partial data is kept)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE769;" FontSize="14" Foreground="{ThemeResource InboundIconPauseBrush}" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResumeButton" Click="Resume_Click" AutomationProperties.Name="Resume">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="ResumeGlyph" Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="ResumeLabel" Text="Resume" />
                    </StackPanel>
                </Button>
                <!-- UI.R35: the package window's words and glyph; "Cancel" alone read as closing the window. -->
                <Button x:Name="CancelButton" Click="Cancel_Click" AutomationProperties.Name="Cancel download">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource InboundIconDangerBrush}" />
                        <TextBlock Text="Cancel download" />
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Content="Hide" Click="Close_Click" MinWidth="92" />
            </local:ActionRowPanel>
        </Grid>
    </Grid>
</Window>
