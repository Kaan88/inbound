<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="MSTest.EnableParentProcessQuery" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\DownloadManager.Desktop.WinUI\ShellFileIconReader.cs" Link="ShellFileIconReader.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\FileLogger.cs" Link="FileLogger.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\TorrentHandlerRegistration.cs" Link="TorrentHandlerRegistration.cs" />
    <Compile Include="..\..\src\DownloadManager.Host.Linux\LinuxTorrentHandler.cs" Link="LinuxTorrentHandler.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\UpdatePostponement.cs" Link="UpdatePostponement.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\ClipboardRetrySchedule.cs" Link="ClipboardRetrySchedule.cs" />
    <Compile Include="..\DownloadManager.Archives.Tests\RarBuilder.cs" Link="RarBuilder.cs" />
    <Compile Include="..\DownloadManager.Archives.Tests\SpannedZipBuilder.cs" Link="SpannedZipBuilder.cs" />
    <Compile Include="..\DownloadManager.Containers.Tests\ContainerFixtures.cs" Link="ContainerFixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DownloadManager.Core\DownloadManager.Core.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Contracts\DownloadManager.Contracts.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Engine\DownloadManager.Engine.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Persistence\DownloadManager.Persistence.csproj" />
    <ProjectReference Include="..\..\tools\TestServer\TestServer.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Runtime\DownloadManager.Runtime.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Torrents\DownloadManager.Torrents.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Archives\DownloadManager.Archives.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Containers\DownloadManager.Containers.csproj" />
    <ProjectReference Include="..\..\src\DownloadManager.Providers.TorBox\DownloadManager.Providers.TorBox.csproj" />
    <!-- Also run as a process (from its own bin folder); referenced for its internal helpers (InternalsVisibleTo). -->
    <ProjectReference Include="..\..\src\DownloadManager.Cli\DownloadManager.Cli.csproj" />
  </ItemGroup>

  <!--
    Run as real processes by the pipe tests, so only built here, not linked. The Host is a Windows program (tray, named
    pipe ACL), so off Windows it isn't built, and the tests that start it carry [Trait("Platform", "Windows")]: run the
    portable set there with dotnet test filter "Platform!=Windows".
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\..\src\DownloadManager.Host\DownloadManager.Host.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
    <ProjectReference Include="..\..\src\DownloadManager.NativeHost\DownloadManager.NativeHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <!-- D8: the web bridge the test Host starts. -->
    <ProjectReference Include="..\..\src\DownloadManager.Server\DownloadManager.Server.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- D8: the Host's web UI parts, tested as they are (no fakes): the firewall and TCP tables are only read. -->
  <ItemGroup>
    <Compile Include="..\..\src\DownloadManager.Host\WebBridgeLauncher.cs" Link="WebUi\WebBridgeLauncher.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\WindowsFirewallRules.cs" Link="WebUi\WindowsFirewallRules.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\TcpListenerOwner.cs" Link="WebUi\TcpListenerOwner.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\WebUiPasswordFile.cs" Link="WebUi\WebUiPasswordFile.cs" />
    <Compile Include="..\..\src\DownloadManager.Host\LocalNetworkAddresses.cs" Link="WebUi\LocalNetworkAddresses.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestPaths.cs" Link="Shared\TestPaths.cs" />
  </ItemGroup>

</Project>
