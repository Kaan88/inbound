# Files read inside a Linux container keep LF line endings in every checkout and in git archive (D3).
Dockerfile text eol=lf
.dockerignore text eol=lf
*.sh text eol=lf
docker/** text eol=lf
.github/workflows/*.yml text eol=lf
native/torrent-worker/Dockerfile.build text eol=lf
native/torrent-worker/** text eol=lf
native/torrent-worker/*.cmd text eol=crlf
# Signed or hashed test fixtures must keep their exact bytes on every checkout (a CRLF checkout breaks the signature).
tests/DownloadManager.Sites.Tests/Fixtures/** -text
