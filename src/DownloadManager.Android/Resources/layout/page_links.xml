<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?android:colorBackground">
  <LinearLayout android:id="@+id/page_links_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="64dp">
      <ImageButton android:id="@+id/page_links_close" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Close" />
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Links on this page" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" android:accessibilityHeading="true" />
      <ImageButton android:id="@+id/page_links_search_toggle" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_search" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Search links" />
    </LinearLayout>
    <TextView android:id="@+id/page_links_host" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <EditText android:id="@+id/page_links_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true" android:hint="Search links" android:inputType="text" android:visibility="gone" />
    <HorizontalScrollView android:id="@+id/page_links_chip_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:id="@+id/page_links_chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <CheckBox android:id="@+id/page_links_select_shown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" />
      <TextView android:id="@+id/page_links_group_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/page_links_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:background="@drawable/bg_page_links_list" android:clipToOutline="true" android:paddingHorizontal="8dp" android:paddingVertical="6dp" />
  </FrameLayout>
  <LinearLayout android:id="@+id/page_links_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/colorSurfaceContainer">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/page_links_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" /><TextView android:id="@+id/page_links_destination" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" /></LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/page_links_download" android:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" android:layout_width="wrap_content" android:layout_height="56dp" android:minHeight="56dp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="28dp" app:icon="@drawable/ic_remote_download" app:iconTint="?attr/colorOnPrimary" app:iconGravity="textStart" app:iconSize="20dp" />
  </LinearLayout>
</LinearLayout>
