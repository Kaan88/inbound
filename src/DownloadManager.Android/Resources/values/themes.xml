<resources>
  <!-- Colour roles of the Figma board "How it works", section 5 (light). -->
  <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="colorPrimary">#1F6FC5</item>
    <!-- Follows colorPrimary, so dynamic colour reaches radio buttons and switches too. -->
    <item name="colorControlActivated">?attr/colorPrimary</item>
    <!-- Inverse roles (snackbars) from the Inbound palette: the other theme's surface, text and primary. -->
    <item name="colorSurfaceInverse">#2C2C2C</item>
    <item name="colorOnSurfaceInverse">#F2F2F2</item>
    <item name="colorPrimaryInverse">#4AA3F0</item>
    <item name="colorOnPrimary">#FFFFFF</item>
    <item name="colorPrimaryContainer">#DCE9F7</item>
    <item name="colorOnPrimaryContainer">#0B2A4A</item>
    <item name="colorSecondaryContainer">#DCE9F7</item>
    <item name="colorOnSecondaryContainer">#0B2A4A</item>
    <item name="colorTertiary">#B35C00</item>
    <item name="colorSurface">#F7F7F8</item>
    <item name="colorOnSurface">#1A1A1A</item>
    <item name="colorSurfaceVariant">#E2E2E2</item>
    <item name="colorOnSurfaceVariant">#666666</item>
    <item name="colorSurfaceContainer">#EDEDED</item>
    <item name="colorSurfaceContainerLow">#EDEDED</item>
    <item name="colorSurfaceContainerHigh">#E6E6E6</item>
    <item name="colorSurfaceContainerHighest">#E2E2E2</item>
    <item name="colorOutline">#8A8A8A</item>
    <item name="colorOutlineVariant">#DADADA</item>
    <item name="android:colorBackground">#F7F7F8</item>
    <item name="colorError">#C42B1C</item>
    <item name="bottomSheetDialogTheme">@style/InboundSheetDialog</item>
  </style>
  <style name="InboundSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
    <item name="android:windowAnimationStyle">@style/InboundSheetAnimation</item>
  </style>
  <!-- Sheets: 400 ms with the emphasized easing in; the scrim is the dialog's own dim (it follows the same window animation). -->
  <style name="InboundSheetAnimation">
    <item name="android:windowEnterAnimation">@anim/sheet_in</item>
    <item name="android:windowExitAnimation">@anim/sheet_out</item>
  </style>
  <color name="state_done">#1B7130</color>
  <color name="state_failed">#C42B1C</color>
  <color name="state_waiting">#8A5A00</color>
  <color name="state_media">#7B4FB8</color>
  <color name="state_done_container">#D5EBDB</color>
  <color name="state_failed_container">#F6D9D5</color>
  <color name="state_waiting_container">#F6E6C4</color>
</resources>
