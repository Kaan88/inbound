{
  "name": "download-manager-bridge",
  "private": true,
  "version": "0.6.2",
  "description": "Inbound Download Manager Chrome extension",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "screens": "node scripts/store-screens.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "jsdom": "30.1.3",
    "typescript": "^5.7.0",
    "web-ext": "10.8.0"
  }
}
